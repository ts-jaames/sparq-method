<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>What it's like to work with us</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..700;1,400..700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --paper: #f5f3ee;
        --ink: #221c16;
        --body: #3a332c;
        --muted: #8a8073;
        --faint: #b7aea1;
        --line: #e3ddd3;
        --line-soft: #ebe6dc;
        --orange: #e75437;
        --hover: #ece7dc;
        --font: "Inter", system-ui, sans-serif;
        --font-serif: "Fraunces", Georgia, serif;
        --rail: 150px;
        --gap: 26px;
        --measure: 592px;
        /* spacing scale: one step per relationship, no near-miss values */
        --space-1: 6px; /* domain label to its capabilities */
        --space-2: 10px; /* capability to capability */
        --space-3: 18px; /* section eyebrow to first domain */
        --space-4: 32px; /* domain to domain, and around the section */
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--body);
        font-family: var(--font);
        font-weight: 400;
        font-size: 13px;
        letter-spacing: .05px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      /* ---------- linear document ---------- */
      .doc-wrap {
        padding: 76px 0 30vh;
        transition: transform 0.7s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      body.silo-open {
        overflow: hidden;
      }
      body.silo-open .doc-wrap {
        transform: translateX(-100vw);
        pointer-events: none;
      }

      .row {
        display: grid;
        grid-template-columns: var(--rail) minmax(0, var(--measure));
        gap: var(--gap);
        justify-content: center;
        scroll-margin-top: 72px;
      }
      .lin {
        opacity: 0;
        filter: blur(4px);
        transition:
          opacity 0.35s ease 0.12s,
          filter 0.35s ease 0.12s;
        pointer-events: none;
        padding-top: 16px;
        text-align: left;
      }
      .row:hover .lin {
        opacity: 1;
        filter: blur(0);
      }
      .lin .anc {
        font-size: 12px;
        font-style: italic;
        color: var(--muted);
        line-height: 1.32;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lin .cur {
        font-size: 13px;
        font-weight: 700;
        color: var(--orange);
        line-height: 1.3;
        display: flex;
        gap: 6px;
        align-items: baseline;
        white-space: nowrap;
        overflow: hidden;
      }
      .lin .cur .ar {
        color: var(--orange);
        flex: none;
      }
      .lin .feel-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        margin-bottom: 7px;
      }
      .lin .cur.feel {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        font-family: var(--font-serif);
        font-weight: 600;
        font-style: normal;
        font-size: 13px;
        color: var(--ink);
        background: var(--hover);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 5px 14px;
        line-height: 1.2;
      }
      .lin .sub-cur {
        font-size: 12px;
        font-weight: 500;
        font-style: italic;
        color: var(--orange);
        opacity: 0.65;
        line-height: 1.3;
        margin-top: 6px;
        margin-left: 15px;
        position: relative;
        white-space: nowrap;
      }
      .lin .sub-cur::before {
        content: "";
        position: absolute;
        left: -12px;
        top: 0.6em;
        width: 8px;
        height: 1px;
        background: var(--faint);
      }
      .col {
        padding: 24px 18px;
        margin: 0 -18px;
      }
      .story-orb-row {
        margin-bottom: -8px;
      }
      .story-orb-wrap {
        width: 84px;
        height: 84px;
      }
      #storyOrbCanvas {
        display: block;
        width: 84px;
        height: 84px;
      }

      body h1 {
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 28px;
        line-height: 1.2;
        letter-spacing: 0;
        color: var(--ink);
        margin: 0 0 14px;
      }
      .opening {
        margin: 0;
      }
      .opening + .opening {
        margin-top: 20px;
      }
      .opening .b {
        font-style: italic;
        color: var(--ink);
      }

      .row.b .col {
        border-radius: 9px;
        transition: background 0.18s ease;
      }
      .row.b:hover .col {
        background: var(--hover);
      }
      body h2 {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 19px;
        line-height: 1.35;
        color: var(--ink);
        margin: 0 0 9px;
      }
      .col p {
        margin: 0 0 12px;
      }
      .col p:last-child {
        margin-bottom: 0;
      }
      .col p em {
        font-style: italic;
        color: var(--ink);
      }

      .endline {
        color: var(--ink);
        font-weight: 400;
        margin: 48px 0 0;
      }

      .brk {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 60px 0 8px;
      }
      .brk::before,
      .brk::after {
        content: "";
        height: 1px;
        background: var(--line);
        flex: 1;
      }
      .brk span {
        font-style: italic;
        font-size: 12px;
        color: var(--muted);
        white-space: nowrap;
      }

      .godeep {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 6px;
        font-style: italic;
        font-size: 13px;
        color: var(--orange);
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--font);
        padding: 0;
      }
      .godeep:hover {
        text-decoration: underline;
      }

      /* ---------- silo (the third level) ---------- */
      .silo {
        position: fixed;
        inset: 0;
        background: transparent;
        pointer-events: none;
        overflow-x: hidden;
        overflow-y: auto;
        z-index: 60;
      }
      body.silo-open .silo {
        pointer-events: auto;
      }

      .silo-ref {
        position: sticky;
        top: 70px;
        align-self: start;
      }
      .silo-back {
        position: fixed;
        top: 24px;
        left: 44px;
        z-index: 80;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--font);
        font-size: 13px;
        font-style: italic;
        color: var(--orange);
        padding: 0;
        display: inline-flex;
        gap: 6px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      body.silo-open .silo-back {
        opacity: 1;
        pointer-events: auto;
        transition: opacity 0.4s ease 0.7s;
      }
      .silo-back:hover {
        text-decoration: underline;
      }
      .ref-label {
        font-style: italic;
        font-size: 12px;
        color: var(--faint);
        margin-bottom: 14px;
      }
      .ref-item {
        margin-bottom: 16px;
        padding-left: 13px;
        border-left: 2px solid var(--line);
        cursor: pointer;
        transition: border-color 0.18s ease;
      }
      .ref-item:hover {
        border-color: var(--orange);
      }
      .ref-item:hover .ref-t {
        color: var(--orange);
      }
      .ref-item.nested {
        margin-left: 16px;
      }
      .ref-tier {
        font-style: italic;
        font-size: 12px;
        color: var(--orange);
        margin-bottom: 2px;
      }
      .ref-t {
        font-weight: 700;
        font-size: 13px;
        color: var(--ink);
        line-height: 1.3;
        margin-bottom: 4px;
      }
      .ref-x {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .silo-main {
        margin: 0 44px 22vh 400px;
        max-width: 600px;
        padding-top: 72px;
        min-width: 0;
        /* sits in its final position and blurs in; the flying paragraph
           lands in the left column at ~0.68s, so the fade waits for it */
        opacity: 0;
        filter: blur(12px);
        visibility: hidden;
        transition:
          opacity 0.3s ease,
          filter 0.3s ease,
          visibility 0s linear 0.3s;
      }
      body.silo-open .silo-main {
        opacity: 1;
        filter: blur(0);
        visibility: visible;
        transition:
          opacity 0.5s ease 0.65s,
          filter 0.55s cubic-bezier(0.22, 0.9, 0.36, 1) 0.65s,
          visibility 0s linear 0.65s;
      }
      .main-eyebrow {
        font-style: italic;
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 8px;
      }
      .silo-main h2 {
        margin: 0 0 20px;
      }
      .silo-main p {
        margin: 0 0 14px;
      }
      .silo-main p em {
        font-style: italic;
        color: var(--ink);
      }

      .col.flying {
        position: fixed;
        z-index: 70;
        margin: 0;
        background: var(--hover);
        border: none;
        border-radius: 10px;
        padding: 14px 16px;
        overflow: hidden;
        box-shadow: none;
        transition:
          top 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          left 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          width 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          max-height 0.65s cubic-bezier(0.22, 0.9, 0.36, 1);
        transition-delay: 0.2s;
      }
      .col.flying h2 {
        font-size: 14px;
        margin-bottom: 6px;
      }
      .col.flying p {
        font-size: 12px;
        line-height: 1.55;
      }
      .col.flying.ref-mode {
        -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
        mask-image: linear-gradient(180deg, #000 72%, transparent);
        max-height: 150px;
        transition-delay: 0s;
      }
      .col.flying:hover {
        max-height: 80vh !important;
        -webkit-mask-image: none;
        mask-image: none;
        overflow-y: auto;
        transition: max-height 0.4s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      .col.flying .godeep {
        display: none;
      }
      .sub {
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--orange);
        margin: var(--space-4) 0 var(--space-3);
        padding-top: 0;
        border-top: none;
      }

      .dom-label {
        font-family: var(--font-serif);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--muted);
        margin-bottom: var(--space-1);
      }
      .cap + .dom-label {
        margin-top: var(--space-4);
      }

      .cap {
        border: 1px solid var(--line);
        border-radius: 24px;
        margin: 0;
        overflow: hidden;
        background: transparent;
        transition:
          background 0.25s ease,
          border-color 0.25s ease,
          border-radius 0.45s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      .cap + .cap {
        margin-top: var(--space-2);
      }
      .cap:hover {
        background: var(--hover);
        border-color: var(--line-soft);
      }
      .cap.open {
        background: var(--hover);
        border-color: var(--line-soft);
        border-radius: 16px;
      }
      .cap-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        width: 100%;
        padding: 15px 18px;
        background: none;
        border: none;
        margin: 0;
        cursor: pointer;
        font-family: var(--font);
        text-align: left;
        -webkit-tap-highlight-color: transparent;
      }
      .cap .nm {
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        font-size: 15px;
        line-height: 1;
        color: var(--ink);
        transition: color 0.25s ease;
      }
      .cap.open .nm {
        color: var(--orange);
      }
      .cap-icon {
        position: relative;
        width: 14px;
        height: 14px;
        flex: none;
        align-self: center;
      }
      .cap-icon::before,
      .cap-icon::after {
        content: "";
        position: absolute;
        background: var(--orange);
        border-radius: 1px;
        transition: transform 0.35s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      .cap-icon::before {
        top: 50%;
        left: 0;
        width: 100%;
        height: 2px;
        transform: translateY(-50%);
      }
      .cap-icon::after {
        left: 50%;
        top: 0;
        width: 2px;
        height: 100%;
        transform: translateX(-50%);
      }
      .cap.open .cap-icon::after {
        transform: translateX(-50%) rotate(90deg);
      }
      .cap-body {
        display: grid;
        grid-template-rows: minmax(0, 0fr);
        transition: grid-template-rows 0.5s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      .cap.open .cap-body {
        grid-template-rows: minmax(0, 1fr);
      }
      .cap-body-in {
        overflow: hidden;
        min-height: 0;
        padding: 0 18px 18px;
        opacity: 0;
        filter: blur(3px);
        transform: translateY(-4px);
        transition:
          opacity 0.3s ease,
          filter 0.3s ease,
          transform 0.3s ease;
      }
      .cap.open .cap-body-in {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
        transition-delay: 0.14s;
      }
      .cap-body-in::before {
        content: "";
        display: block;
        height: 1px;
        background: var(--line-soft);
        margin-bottom: 14px;
      }
      .cap .r {
        display: block;
        margin-bottom: 4px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--body);
      }
      .cap .r .lbl {
        font-style: italic;
        font-weight: 500;
        color: var(--ink);
        margin-right: 7px;
      }
      .cap .r.out .lbl {
        font-weight: 500;
        color: var(--ink);
      }
      .cap-note {
        font-style: italic;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
        margin: var(--space-4) 0;
        padding-top: 0;
        border-top: none;
      }

      @media (max-width: 800px) {
        .row {
          grid-template-columns: 1fr;
          padding: 0 24px;
        }
        .lin {
          display: none;
        }
        .row.b .col {
          margin: 6px -14px;
        }
        .silo-main {
          margin-left: 24px;
          margin-right: 24px;
          padding-top: 64px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .doc-wrap,
        .silo-main,
        .col.flying {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="doc-wrap">
      <div class="row story-orb-row">
        <div class="lin"></div><div class="col">
          <div class="story-orb-wrap">
            <canvas id="storyOrbCanvas" aria-hidden="true"></canvas>
          </div>
        </div>
      </div>

      <!-- ===== THE NARRATIVE ===== -->
      <div class="row">
        <div class="lin"></div><div class="col">
          <h1>What it&rsquo;s like to work with us</h1>
          <p class="opening">
            You have something that has to work. You also have a quiet fear
            riding along with it, because you know how this usually goes. The
            big team. The long discovery. The deck that looks certain. And the
            month&#8209;four meeting where the confidence turns out to have
            been theater, and the cost of it lands on you.
          </p>
          <p class="opening">
            That fear isn&rsquo;t yours to carry. It&rsquo;s the tell of a
            broken bargain: most firms sell you confidence they can&rsquo;t
            back, and quietly price in the cost of being wrong, you just
            don&rsquo;t see the bill until it&rsquo;s too late to change
            course. We built the opposite. Not advisors, not project managers,
            but builders: engineers who carry a product company&rsquo;s
            instincts into the work, whose pride is in what ships and keeps
            shipping. Here, confidence isn&rsquo;t asserted in a deck.
            It&rsquo;s earned in front of you, week by week, where you can
            watch it happen. Here&rsquo;s what that feels like.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="feel-label">Feeling</div>
          <div class="cur feel">Understood</div>
        </div><div
          class="col"
        >
          <h2>
            The first conversation is about your business, not our process.
          </h2>
          <p>
            Most firms open by telling you how they work, then build what you
            asked for. We open by asking what has to be true for this to have
            been worth the money and the year, and we don&rsquo;t stop at the
            feature you requested. We push to the commercial lever underneath
            it: the cost you&rsquo;re carrying, the segment you can&rsquo;t
            reach, the number your board actually watches. Sometimes that means
            telling you the thing you came to build isn&rsquo;t the thing worth
            building, before a dollar is spent, not after. Because the most
            expensive mistake in software isn&rsquo;t a bug; it&rsquo;s a year
            spent shipping something that didn&rsquo;t move the business,
            beautifully. You walk out understanding your own problem more
            sharply than when you walked in, occasionally understanding it was
            a different problem than you thought. Not just managed. Understood.
          </p>
        </div>
      </div>

      <div class="row b" id="beat-riskiest">
        <div class="lin">
          <div class="feel-label">Feeling</div>
          <div class="cur feel">Confident</div>
        </div><div
          class="col"
        >
          <h2>We start by building the riskiest thing first.</h2>
          <p>
            Every serious build rests on two or three assumptions that, if
            they&rsquo;re wrong, change everything: the integration
            nobody&rsquo;s tested, the constraint nobody&rsquo;s checked. Most
            firms write those down as risks and keep moving; the risk surfaces
            in month four, and by then it costs a quarter. We do the opposite.
            The first real engineering we do aims straight at the part most
            likely to break, because the fastest way to know whether something
            works is to make it work. A failure in week two is cheap; the same
            failure in month four is a catastrophe. So the thing every other
            engagement quietly charges you for (the cost of being wrong, late)
            mostly disappears. And when we finally tell you what the whole
            thing will cost and how long it will take, you don&rsquo;t hope the
            number is right. You believe it, because you watched us earn it.
          </p>
          <button class="godeep" data-silo="riskiest"
            >&larr;&nbsp; A deeper dive into this one</button
          >
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="feel-label">Feeling</div>
          <div class="cur feel">Calm</div>
        </div><div class="col">
          <h2>You watch it get built.</h2>
          <p>
            On every project you&rsquo;ve run, confidence was highest the day
            you signed (the plan fresh, nothing gone wrong yet) and it eroded
            from there as reality arrived. With us it runs backwards: it
            starts low, when we know the least, and climbs every week, because
            the questioning that killed the early risks never switches off. It
            just moves to smaller, later ones as the big ones die, so the
            assumption everyone else stops checking around month four is still
            being checked here. There are no status meetings, because the
            build itself is the status: always something real running in
            front of you, and every decision written down beside the work, so
            the reasoning is never trapped in one head. Somewhere around week
            six you notice you&rsquo;ve stopped bracing for the
            bad&#8209;news meeting. It isn&rsquo;t coming. That&rsquo;s not
            reassurance: it&rsquo;s your confidence finally pointing the same
            direction as the facts.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="feel-label">Feeling</div>
          <div class="cur feel">Empowered</div>
        </div><div class="col">
          <h2>You come out of this more capable than you went in.</h2>
          <p>
            You keep the thing that works, but the bigger inheritance is what
            you now believe you can do. Most engagements quietly lower your
            ceiling: you finish knowing, in expensive detail, how hard the
            thing was. This one raises it. The idea that got laughed out of
            the room (the one you filed under &ldquo;too risky&rdquo; or
            &ldquo;someday&rdquo;), you look at it differently now, because
            you&rsquo;ve watched the scariest part of a real build get
            de&#8209;risked in weeks and ship. And you&rsquo;re not just
            bolder; you&rsquo;re equipped: your people understand why it works
            because they were in the room when the calls got made, and the
            ground underneath is clean enough to build the next thing on.
            Ambition and the means to act on it arrive together. The
            initiative you were quietly afraid of became the one that proved
            what&rsquo;s possible, and the next one no longer needs our
            permission, or our presence, unless you decide it does.
          </p>
        </div>
      </div>

      <div class="row">
        <div class="lin"></div><div class="col">
          <p class="endline">
            This isn&rsquo;t a better consultancy. It&rsquo;s a different bet
            about what a consultancy is for: that the job was never to look
            certain, but to make certainty something you can watch being
            earned, and to leave the fear behind for good.
            <br><br>Outcomes over hours.<br> Confidence over theater.
          </p>
        </div>
      </div>

    </div><!-- /.doc-wrap -->

    <!-- ===== SILO · third level ===== -->
    <div class="silo" id="silo-riskiest">
      <button class="silo-back">&larr;&nbsp; Back to the narrative</button>
      <main class="silo-main">
        <h1>How it actually works</h1>

        <p>
          Early work has two jobs, not one. It has to find out whether the
          hard thing can be built, and whether it&rsquo;s the right thing to
          build at all. Most of what follows is one discipline serving both.
        </p>
        <p>
          Start with the word <em>riskiest</em>, because it&rsquo;s doing
          precise work. On most projects, risk gets spread evenly, every
          requirement treated as roughly equal, worked in the order someone
          wrote it down. We don&rsquo;t. Before anything gets built, we separate
          the handful of assumptions that would actually break the initiative if
          they&rsquo;re wrong from the hundred that wouldn&rsquo;t. Some of
          those are feasibility risks: whether the hard part can be built.
          Others are direction risks: whether this is even the thing worth
          building. Two or three of them, of either kind, usually decide
          whether the whole initiative is viable. Those go first.
        </p>
        <p>
          <em>First</em> doesn&rsquo;t mean we discuss them first. It means we build
          them first. For the top assumption we make the smallest real version of
          the thing most likely to fail, the hard part itself, running. And we decide,
          before we build it, what would count as it working and what would
          count as it failing: a build with no predefined bar produces a demo and
          a round of opinions; a build with a bar produces a result.
        </p>
        <p>
          But the build does a second thing at the same time, and it&rsquo;s
          the half that makes this consulting rather than a validation lab. A
          working artifact in front of a client changes the strategic
          conversation in a way no document can. An abstract question (which
          segment to serve, which direction to commit to, what the product
          should even be) stays abstract on a slide and gets decided the
          moment there&rsquo;s something real to react to. So we put the
          thing in front of the client early, on purpose. Not to demo it. To
          force a direction&#8209;level decision into the open while
          it&rsquo;s still cheap to change our minds.
        </p>
        <p>
          That means signal comes in two forms, and both matter. There&rsquo;s
          the instrumented result: did the hard part work, against the bar we
          set. And there&rsquo;s the strategic signal: what the client, seeing
          it real, now understands they actually want; which direction
          suddenly looks wrong; the question the prototype surfaced that
          nobody knew to ask. The first earns confidence that we can build it.
          The second earns confidence that it&rsquo;s the right thing to
          build.
        </p>
        <p>
          One discipline holds across both, and it&rsquo;s what keeps the
          strategic conversation from collapsing into the demo we just warned
          against: it still ends in a recorded decision. A working thing can
          produce a wonderful discussion and no decision; that&rsquo;s a
          demo. We require the direction conversation to close on an explicit
          call (commit to this direction, adjust it, or drop it) the same way
          we require the technical result to clear a bar. Opinions
          don&rsquo;t move the initiative. Recorded decisions do.
        </p>
        <p>
          That&rsquo;s why capabilities don&rsquo;t move in lockstep.
          Confidence is earned per question, on both axes, so a capability
          proven on feasibility and settled on direction enters real build,
          hardened and scoped, while one that&rsquo;s still an open question
          keeps getting tested. You are never scaling investment on
          something you haven&rsquo;t proven you can build or decided is
          worth building. It&rsquo;s also why the number holds: proven work
          is priced tight, and what&rsquo;s still a bet, feasibility or
          direction, is named as a bet, with a window to settle it.
        </p>

        <div class="sub">The capabilities at work</div>

        <div class="dom-label">Framing</div>
        <div class="cap">
          <button class="cap-head" aria-expanded="false">
            <span class="nm">Risk framing</span>
            <span class="cap-icon" aria-hidden="true"></span>
          </button>
          <div class="cap-body">
            <div class="cap-body-in">
              <span class="r"
                ><span class="lbl">Why it&rsquo;s here</span>You can&rsquo;t
                build the riskiest thing first until you know which thing is
                riskiest, and risk isn&rsquo;t only technical. This separates
                the two or three collapse&#8209;level assumptions (whether it
                can be built, and whether it&rsquo;s the right thing to
                build) from the hundred that don&rsquo;t move the
                investment, ranked by impact if wrong, uncertainty, and cost
                to test.</span
              >
              <span class="r out"
                ><span class="lbl">Produces</span>A prioritized shortlist of
                the assumptions that govern the commitment, feasibility and
                direction alike.</span
              >
            </div>
          </div>
        </div>
        <div class="dom-label">Proving</div>
        <div class="cap">
          <button class="cap-head" aria-expanded="false">
            <span class="nm">Thin&#8209;slice engineering</span>
            <span class="cap-icon" aria-hidden="true"></span>
          </button>
          <div class="cap-body">
            <div class="cap-body-in">
              <span class="r"
                ><span class="lbl">Why it&rsquo;s here</span>The fastest way
                to know whether the hard part works is to build it: the
                smallest real, instrumented version of the thing most likely
                to break, not a mockup of the easy screens. And where the
                risk is about direction or value, that same slice is the
                artifact we put in front of the client, real enough to
                provoke a sharper strategic decision than any deck would.
                Where the risk is behavioral, the slice is a working
                prototype real users touch.</span
              >
              <span class="r out"
                ><span class="lbl">Produces</span>A running artifact that
                generates real signal early: technical signal against a bar,
                and strategic signal from a client reacting to something
                real, before architecture is committed.</span
              >
            </div>
          </div>
        </div>
        <div class="cap">
          <button class="cap-head" aria-expanded="false">
            <span class="nm">Signal definition &amp; instrumentation</span>
            <span class="cap-icon" aria-hidden="true"></span>
          </button>
          <div class="cap-body">
            <div class="cap-body-in">
              <span class="r"
                ><span class="lbl">Why it&rsquo;s here</span>A slice with no
                predefined bar produces a demo and opinions. This sets, in
                advance, what counts as success and failure on feasibility,
                and what decision the strategic conversation has to reach on
                direction, then wires the slice to surface both.</span
              >
              <span class="r out"
                ><span class="lbl">Produces</span>A clean,
                assumption&#8209;linked result on both axes: evidence rather
                than enthusiasm, and a direction call rather than a round of
                reactions.</span
              >
            </div>
          </div>
        </div>
        <div class="dom-label">Deciding</div>
        <div class="cap">
          <button class="cap-head" aria-expanded="false">
            <span class="nm">Confidence evaluation</span>
            <span class="cap-icon" aria-hidden="true"></span>
          </button>
          <div class="cap-body">
            <div class="cap-body-in">
              <span class="r"
                ><span class="lbl">Why it&rsquo;s here</span>Signal only
                matters if it changes a decision. This judges signal against
                the evidence the next commitment demands (the more
                irreversible the step, the higher the bar) and records an
                explicit promote, iterate, pivot, or stop: on whether we can
                build it, and on whether we should.</span
              >
              <span class="r out"
                ><span class="lbl">Produces</span>A logged decision that
                earns real build or redirects the effort, on feasibility and
                direction both. No silent scaling.</span
              >
            </div>
          </div>
        </div>
        <div class="cap">
          <button class="cap-head" aria-expanded="false">
            <span class="nm">Confidence&#8209;based estimation</span>
            <span class="cap-icon" aria-hidden="true"></span>
          </button>
          <div class="cap-body">
            <div class="cap-body-in">
              <span class="r"
                ><span class="lbl">Why it&rsquo;s here</span>The number holds
                only if it reflects what&rsquo;s known. This prices proven
                capabilities tight, buffers the directional ones, and puts
                explicit windows on what&rsquo;s still unsettled, technically
                or strategically.</span
              >
              <span class="r out"
                ><span class="lbl">Produces</span>An estimate traceable to
                signal, honest about fact versus bet.</span
              >
            </div>
          </div>
        </div>
        <div class="cap-note">
          These run as one loop, not a sequence: framing points at the risk, a
          slice generates signal against a predefined bar and provokes the
          direction decision, evaluation turns both into a recorded call, and
          estimation prices what the decision made true. The loop repeats at
          the next&#8209;highest risk until there&rsquo;s enough earned
          confidence (that it works, and that it&rsquo;s right) to commit.
        </div>

        <p>
          Ownership works the same way. The right capability is applied by
          whoever can clear the bar the work demands, not by a fixed title.
          What doesn&rsquo;t move is the decision: each commitment has one
          owner accountable for the call to promote, pivot, or stop.
        </p>
      </main>
    </div>

    <script is:inline>
      const body = document.body;
      let flyer = null,
        ph = null,
        home = null,
        homeRect = null;

      document.querySelectorAll(".godeep").forEach((a) =>
        a.addEventListener("click", (e) => {
          e.preventDefault();
          openSilo(a);
        }),
      );
      document.querySelector(".silo-back").addEventListener("click", closeSilo);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && body.classList.contains("silo-open"))
          closeSilo();
      });

      document.querySelectorAll(".cap-head").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = btn.closest(".cap");
          if (!item) return;
          const isOpen = item.classList.toggle("open");
          btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
        });
      });

      function openSilo(btn) {
        const col = btn.closest(".col");
        if (!col || flyer) return;
        const r = col.getBoundingClientRect();
        flyer = col;
        home = col.parentNode;
        homeRect = r;
        ph = document.createElement("div");
        ph.style.height = r.height + "px";
        ph.className = "fly-ph";
        home.insertBefore(ph, col);
        body.appendChild(col);
        col.classList.add("flying");
        col.style.top = r.top + "px";
        col.style.left = r.left + "px";
        col.style.width = r.width + "px";
        col.style.maxHeight = r.height + "px";
        body.classList.add("silo-open");
        const s = document.querySelector(".silo");
        if (s) s.scrollTop = 0;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            col.classList.add("ref-mode");
            col.style.top = "72px";
            col.style.left = "44px";
            col.style.width = "320px";
            col.style.maxHeight = "150px";
          }),
        );
      }

      function closeSilo() {
        body.classList.remove("silo-open");
        if (!flyer || !ph) return;
        const col = flyer,
          placeholder = ph,
          homeParent = home,
          r = homeRect;
        flyer = null;
        ph = null;
        col.classList.remove("ref-mode");
        col.style.top = r.top + "px";
        col.style.left = r.left + "px";
        col.style.width = r.width + "px";
        col.style.maxHeight = r.height + "px";
        setTimeout(() => {
          col.classList.remove("flying");
          col.removeAttribute("style");
          delete col.dataset.tier;
          homeParent.insertBefore(col, placeholder);
          placeholder.remove();
        }, 950);
      }

      // ── Thinking-orb, ported from the homepage hero (ported from
      // thinking-orbs engine/web.ts): a constellation of nodes on a
      // slowly-spinning sphere wires itself, drawn small here as a mark
      // above the opening line. ──
      function initStoryOrb() {
        const el = document.getElementById("storyOrbCanvas");
        if (!el || el.dataset.init) return;
        el.dataset.init = "1";

        const SIZE = el.offsetWidth;
        if (SIZE < 10) return;

        const dpr = window.devicePixelRatio || 1;
        el.width = SIZE * dpr;
        el.height = SIZE * dpr;

        const ctx = el.getContext("2d");
        if (!ctx) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const COLOR = "#E75437";
        const SIGNAL_COLOR = "#F4845F";
        const cx = SIZE / 2;
        const cy = SIZE / 2;

        const nodeN = 80;
        const thr = 0.68;
        const nodeR = 2,
          nodeRDepth = 2.8;
        const signals = 8;
        const lineW = 0.5;
        const SPEED = 1.8;
        const spread = 1;
        const ORB_R = (SIZE / 2) * 0.8 * spread;
        const rs = Math.pow(SIZE / 600, 0.3);

        function frac(x) {
          return x - Math.floor(x);
        }
        function lerp(a, b, f) {
          return a + (b - a) * f;
        }
        function hashD(a, b) {
          const h = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453;
          return h - Math.floor(h);
        }
        function vnoise(x, y) {
          const xi = Math.floor(x),
            yi = Math.floor(y);
          let fx = x - xi,
            fy = y - yi;
          fx = fx * fx * (3 - 2 * fx);
          fy = fy * fy * (3 - 2 * fy);
          const a = hashD(xi, yi),
            b = hashD(xi + 1, yi),
            c = hashD(xi, yi + 1),
            d = hashD(xi + 1, yi + 1);
          return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
        }
        const GOLDEN = Math.PI * (3 - Math.sqrt(5));
        function fibDir(i, n) {
          const y = 1 - (2 * (i + 0.5)) / n;
          const rad = Math.sqrt(1 - y * y);
          const a = i * GOLDEN;
          return [rad * Math.cos(a), y, rad * Math.sin(a)];
        }
        function makeProj(yaw, tilt) {
          const st = Math.sin(tilt),
            ct = Math.cos(tilt),
            sy = Math.sin(yaw),
            cyw = Math.cos(yaw);
          return function (x, y, z) {
            const x1 = x * cyw + z * sy;
            const z1 = -x * sy + z * cyw;
            const y1 = y * ct - z1 * st;
            const z2 = y * st + z1 * ct;
            return [cx + x1 * ORB_R, cy - y1 * ORB_R, z2];
          };
        }

        const reduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const startT = performance.now();

        function frame(t) {
          ctx.clearRect(0, 0, SIZE, SIZE);
          const pt = makeProj(t * 0.12, 0.32);

          const nodes = [];
          for (let i = 0; i < nodeN; i++) {
            const dir = fibDir(i, nodeN);
            const nx = dir[0] + 0.3 * (vnoise(i * 0.31 + 9, t * 0.24) - 0.5) * 2;
            const ny = dir[1] + 0.3 * (vnoise(i * 0.53 + 27, t * 0.21) - 0.5) * 2;
            const nz = dir[2] + 0.3 * (vnoise(i * 0.77 + 55, t * 0.27) - 0.5) * 2;
            const nl = Math.sqrt(nx * nx + ny * ny + nz * nz);
            nodes.push([nx / nl, ny / nl, nz / nl]);
          }

          ctx.lineWidth = Math.max(0.6, lineW * rs);
          for (let i2 = 0; i2 < nodeN; i2++) {
            for (let j2 = i2 + 1; j2 < nodeN; j2++) {
              const dx = nodes[i2][0] - nodes[j2][0];
              const dy = nodes[i2][1] - nodes[j2][1];
              const dz = nodes[i2][2] - nodes[j2][2];
              const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
              if (dist >= thr) continue;
              const pa = pt(nodes[i2][0], nodes[i2][1], nodes[i2][2]);
              const pb = pt(nodes[j2][0], nodes[j2][1], nodes[j2][2]);
              const edepth = ((pa[2] + pb[2]) / 2 + 1) / 2;
              ctx.globalAlpha = (1 - dist / thr) * (0.3 + 0.55 * edepth);
              ctx.strokeStyle = COLOR;
              ctx.beginPath();
              ctx.moveTo(pa[0], pa[1]);
              ctx.lineTo(pb[0], pb[1]);
              ctx.stroke();
            }
          }

          const dots = [];
          for (let i3 = 0; i3 < nodeN; i3++) {
            const pn = pt(nodes[i3][0], nodes[i3][1], nodes[i3][2]);
            const depth = (pn[2] + 1) / 2;
            const pulse = 1 + 0.25 * Math.sin(t * 1.4 + i3 * 2.7);
            dots.push({
              x: pn[0],
              y: pn[1],
              z: pn[2],
              r: (nodeR + nodeRDepth * depth) * pulse * rs,
              color: COLOR,
              a: 0.25 + 0.75 * depth,
            });
          }
          for (let s = 0; s < signals; s++) {
            const seg = Math.floor(t * 0.55 + s * 7.31);
            const ai = Math.floor(hashD(seg, s * 3.1 + 1.7) * nodeN);
            const bi = Math.floor(hashD(seg, s * 5.7 + 4.2) * nodeN);
            if (ai === bi) continue;
            const f = frac(t * 0.55 + s * 7.31);
            const sx = lerp(nodes[ai][0], nodes[bi][0], f);
            const sy2 = lerp(nodes[ai][1], nodes[bi][1], f);
            const sz = lerp(nodes[ai][2], nodes[bi][2], f);
            const sl = Math.max(1e-6, Math.sqrt(sx * sx + sy2 * sy2 + sz * sz));
            const ps = pt(sx / sl, sy2 / sl, sz / sl);
            const sdepth = (ps[2] + 1) / 2;
            dots.push({
              x: ps[0],
              y: ps[1],
              z: ps[2],
              r: (nodeR * 1.5 + nodeRDepth * sdepth) * rs,
              color: SIGNAL_COLOR,
              a: 0.5 + 0.5 * sdepth,
            });
          }

          dots.sort((p, q) => p.z - q.z);
          for (let k = 0; k < dots.length; k++) {
            const dd = dots[k];
            if (dd.a < 0.02) continue;
            ctx.globalAlpha = dd.a;
            ctx.fillStyle = dd.color;
            ctx.beginPath();
            ctx.arc(dd.x, dd.y, Math.max(0.3, dd.r), 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
        }

        function tick() {
          if (!document.body.contains(el)) return;
          frame(((performance.now() - startT) / 1000) * SPEED);
          requestAnimationFrame(tick);
        }

        if (reduced) {
          frame(1.2);
        } else {
          requestAnimationFrame(tick);
        }
      }

      initStoryOrb();
    </script>
  </body>
</html>
