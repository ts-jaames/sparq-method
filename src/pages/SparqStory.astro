<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>What it's like to work with us</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,300..900;1,300..900&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --paper: #f5f3ee;
        --ink: #221c16;
        --body: #3a332c;
        --muted: #8a8073;
        --faint: #b7aea1;
        --line: #e3ddd3;
        --line-soft: #ebe6dc;
        --orange: #e75437;
        --hover: #ece7dc;
        --serif: "Geist", system-ui, sans-serif;
        --rail: 150px;
        --gap: 26px;
        --measure: 592px;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--body);
        font-family: var(--serif);
        font-weight: 400;
        font-size: 13.5px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      /* ---------- linear document ---------- */
      .doc-wrap {
        padding: 76px 0 30vh;
        transition: transform 0.7s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      body.silo-open {
        overflow: hidden;
      }
      body.silo-open .doc-wrap {
        transform: translateX(-100vw);
        pointer-events: none;
      }

      .row {
        display: grid;
        grid-template-columns: var(--rail) minmax(0, var(--measure));
        gap: var(--gap);
        justify-content: center;
        scroll-margin-top: 72px;
      }
      .lin {
        opacity: 0;
        filter: blur(4px);
        transition:
          opacity 0.35s ease 0.12s,
          filter 0.35s ease 0.12s;
        pointer-events: none;
        padding-top: 16px;
        text-align: left;
      }
      .row:hover .lin {
        opacity: 1;
        filter: blur(0);
      }
      .lin .anc {
        font-size: 12.5px;
        font-style: italic;
        color: var(--muted);
        line-height: 1.32;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .lin .cur {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--orange);
        line-height: 1.3;
        display: flex;
        gap: 6px;
        align-items: baseline;
        white-space: nowrap;
        overflow: hidden;
      }
      .lin .cur .ar {
        color: var(--orange);
        flex: none;
      }
      .lin .sub-cur {
        font-size: 12px;
        font-weight: 500;
        font-style: italic;
        color: var(--orange);
        opacity: 0.65;
        line-height: 1.3;
        margin-top: 6px;
        margin-left: 15px;
        position: relative;
        white-space: nowrap;
      }
      .lin .sub-cur::before {
        content: "";
        position: absolute;
        left: -12px;
        top: 0.6em;
        width: 8px;
        height: 1px;
        background: var(--faint);
      }
      .col {
        min-width: 0;
      }

      .col h2.hero {
        font-weight: 700;
        font-size: 24px;
        line-height: 1.16;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0 0 14px;
      }
      .opening {
        margin: 0;
      }
      .opening .b {
        font-style: italic;
        color: var(--ink);
      }

      .row.b .col {
        padding: 14px 18px;
        margin: 6px -18px;
        border-radius: 9px;
        transition: background 0.18s ease;
      }
      .row.b:hover .col {
        background: var(--hover);
      }
      .col h2 {
        font-weight: 700;
        font-size: 17px;
        line-height: 1.3;
        color: var(--ink);
        margin: 0 0 9px;
      }
      .col h3 {
        font-weight: 700;
        font-size: 18px;
        line-height: 1.3;
        color: var(--ink);
        margin: 0 0 9px;
      }
      .col p {
        margin: 0 0 12px;
      }
      .col p:last-child {
        margin-bottom: 0;
      }
      .col p em {
        font-style: italic;
        color: var(--ink);
      }

      .endline {
        color: var(--ink);
        font-weight: 700;
        background: #f1ede5;
        padding: 18px 20px;
        border-radius: 9px;
        margin: 34px 0 0;
      }

      .brk {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 60px 0 8px;
      }
      .brk::before,
      .brk::after {
        content: "";
        height: 1px;
        background: var(--line);
        flex: 1;
      }
      .brk span {
        font-style: italic;
        font-size: 13px;
        color: var(--muted);
        white-space: nowrap;
      }

      .godeep {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 6px;
        font-style: italic;
        font-size: 14px;
        color: var(--orange);
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--serif);
        padding: 0;
      }
      .godeep:hover {
        text-decoration: underline;
      }

      /* ---------- silo (the third level) ---------- */
      .silo {
        position: fixed;
        inset: 0;
        background: transparent;
        pointer-events: none;
        overflow-x: hidden;
        overflow-y: auto;
        z-index: 60;
      }
      body.silo-open .silo {
        pointer-events: auto;
      }

      .silo-ref {
        position: sticky;
        top: 70px;
        align-self: start;
      }
      .silo-back {
        position: fixed;
        top: 24px;
        left: 44px;
        z-index: 80;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--serif);
        font-size: 13.5px;
        font-style: italic;
        color: var(--orange);
        padding: 0;
        display: inline-flex;
        gap: 6px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease 0.35s;
      }
      body.silo-open .silo-back {
        opacity: 1;
        pointer-events: auto;
      }
      .silo-back:hover {
        text-decoration: underline;
      }
      .ref-label {
        font-style: italic;
        font-size: 11.5px;
        color: var(--faint);
        margin-bottom: 14px;
      }
      .ref-item {
        margin-bottom: 16px;
        padding-left: 13px;
        border-left: 2px solid var(--line);
        cursor: pointer;
        transition: border-color 0.18s ease;
      }
      .ref-item:hover {
        border-color: var(--orange);
      }
      .ref-item:hover .ref-t {
        color: var(--orange);
      }
      .ref-item.nested {
        margin-left: 16px;
      }
      .ref-tier {
        font-style: italic;
        font-size: 11px;
        color: var(--orange);
        margin-bottom: 2px;
      }
      .ref-t {
        font-weight: 700;
        font-size: 14px;
        color: var(--ink);
        line-height: 1.3;
        margin-bottom: 4px;
      }
      .ref-x {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .silo-main {
        margin: 0 44px 22vh 400px;
        max-width: 600px;
        padding-top: 72px;
        min-width: 0;
        transform: translateX(100vw);
        transition: transform 0.7s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      body.silo-open .silo-main {
        transform: translateX(0);
        transition: transform 0.7s cubic-bezier(0.22, 0.9, 0.36, 1) 0.15s;
      }
      .main-eyebrow {
        font-style: italic;
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 8px;
      }
      .silo-main h2 {
        font-weight: 700;
        font-size: 25px;
        color: var(--ink);
        margin: 0 0 20px;
        line-height: 1.18;
        letter-spacing: -0.01em;
      }
      .silo-main p {
        margin: 0 0 14px;
      }
      .silo-main p em {
        font-style: italic;
        color: var(--ink);
      }

      .col.flying {
        position: fixed;
        z-index: 70;
        margin: 0;
        background: var(--hover);
        border: none;
        border-radius: 10px;
        padding: 14px 16px;
        overflow: hidden;
        box-shadow: none;
        transition:
          top 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          left 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          width 0.65s cubic-bezier(0.22, 0.9, 0.36, 1),
          max-height 0.65s cubic-bezier(0.22, 0.9, 0.36, 1);
        transition-delay: 0.2s;
      }
      .col.flying::before {
        content: attr(data-tier);
        display: block;
        font-style: italic;
        font-size: 10px;
        color: var(--orange);
        margin-bottom: 4px;
      }
      .col.flying h2,
      .col.flying h3 {
        font-size: 14px;
        margin-bottom: 6px;
      }
      .col.flying p {
        font-size: 12.5px;
        line-height: 1.55;
      }
      .col.flying.ref-mode {
        -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
        mask-image: linear-gradient(180deg, #000 72%, transparent);
        max-height: 150px;
        transition-delay: 0s;
      }
      .col.flying:hover {
        max-height: 80vh !important;
        -webkit-mask-image: none;
        mask-image: none;
        overflow-y: auto;
        transition: max-height 0.4s cubic-bezier(0.22, 0.9, 0.36, 1);
      }
      .col.flying .godeep {
        display: none;
      }
      .sub {
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--orange);
        margin: 30px 0 14px;
        padding-top: 0;
        border-top: none;
      }

      .cap {
        margin: 0 0 20px;
      }
      .cap .nm {
        font-weight: 700;
        font-size: 16px;
        color: var(--ink);
        margin-bottom: 5px;
      }
      .cap .r {
        display: block;
        margin-bottom: 4px;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--body);
      }
      .cap .r .lbl {
        font-style: italic;
        font-weight: 500;
        color: var(--ink);
        margin-right: 7px;
      }
      .cap .r.out .lbl {
        font-weight: 500;
        color: var(--ink);
      }
      .cap-note {
        font-style: italic;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.55;
        margin-top: 18px;
        padding-top: 0;
        border-top: none;
      }

      @media (max-width: 800px) {
        .row {
          grid-template-columns: 1fr;
          padding: 0 24px;
        }
        .lin {
          display: none;
        }
        .row.b .col {
          margin: 6px -14px;
        }
        .silo-main {
          margin-left: 24px;
          margin-right: 24px;
          padding-top: 64px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .doc-wrap,
        .silo-main,
        .col.flying {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="doc-wrap">
      <!-- ===== THE NARRATIVE ===== -->
      <div class="row">
        <div class="lin"></div><div class="col">
          <h2 class="hero">What it&rsquo;s like to work with us</h2>
          <p class="opening">
            You have something that has to work. You also have a quiet fear
            riding along with it. You know how this usually goes: the big team,
            the long discovery, the deck that looks certain, and the
            month&#8209;four meeting where the confidence turns out to have been
            theater. We built a different kind of consultancy: not advisors, not
            project managers, but <span class="b">builders</span>: engineers who
            carry a product company&rsquo;s instincts into the work, whose pride
            is in what actually ships and keeps shipping. Here&rsquo;s what it
            feels like to build with us.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin"><div class="cur">Understood</div></div><div
          class="col"
        >
          <h2>
            The first conversation is about your business, not our process.
          </h2>
          <p>
            Most firms open by telling you how they work. We open by asking what
            has to be true for your business for this to have been worth doing.
            We push past the feature request to the commercial lever underneath
            it: the cost you&rsquo;re carrying, the market segment you
            can&rsquo;t reach, the metric your board actually watches. You walk
            out of that first conversation understanding your own problem more
            clearly than when you walked in. That&rsquo;s the baseline with us,
            not the exception: not just managed, understood.
          </p>
        </div>
      </div>

      <div class="row b" id="beat-riskiest">
        <div class="lin"><div class="cur">Confidence</div></div><div
          class="col"
        >
          <h2>We start by building the riskiest thing first.</h2>
          <p>
            Every serious build rests on two or three assumptions that, if
            they&rsquo;re wrong, change everything: the integration
            nobody&rsquo;s tested, the constraint nobody&rsquo;s checked. Most
            firms write those down as risks and move on. We build them. The
            first real engineering we do is aimed straight at the part most
            likely to break, because the fastest way to know whether something
            works is to make it work. You don&rsquo;t get a paragraph promising
            it&rsquo;ll be fine; you get the hard thing, running, early enough
            that a failure is cheap instead of a crisis. And when we finally
            tell you what the whole thing will cost and how long it will take,
            you believe the number. Not because we&rsquo;re persuasive. Because
            you watched us build the proof.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin"><div class="cur">Calm</div></div><div class="col">
          <h2>You watch it get built.</h2>
          <p>
            There are no status meetings where people read slides at you,
            because the build itself is the status: always something real
            running in front of you, not a report about it. Decisions get made
            in working code and written down with the same care as the code, so
            the reasoning is never trapped in one person&rsquo;s head. Three
            months in, no one asks you to re&#8209;explain a call from month
            one. And the questioning that killed the early risks never switches
            off; it just moves to smaller, later ones as the big ones die, so
            the assumption everyone else stops checking around month four is
            still being checked here. Somewhere around week six you notice
            you&rsquo;ve stopped bracing. That&rsquo;s the build earning it,
            week over week.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin"><div class="cur">Empowered</div></div><div class="col">
          <h2>You come out of this more capable than you went in.</h2>
          <p>
            You have the thing that works, but you also have the engineered
            ground underneath it. Architecture your team can read, a codebase
            they can own, systems clean enough to build the next thing on
            without calling us to open a box we sealed. Your people understand
            why it works because they watched it get built, not because we
            briefed them at the end. The initiative you were quietly afraid of
            became the one that proved what&rsquo;s possible. That&rsquo;s when
            the real leverage starts: standing on ground you trust, with more
            range than you had before, free to decide whether the next thing
            even needs us.
          </p>
        </div>
      </div>

      <div class="row">
        <div class="lin"></div><div class="col">
          <p class="endline">
            Not a better consultancy. A different bet about what a consultancy
            is for. Outcomes over hours. Confidence over theater.
          </p>
        </div>
      </div>

      <!-- ===== A LAYER DEEPER ===== -->
      <div class="row">
        <div class="lin"></div><div class="col">
          <div class="brk"><span>Approach</span></div>
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="cur">Understood</div><div class="sub-cur">Approach</div>
        </div><div class="col">
          <h3>Finding the one sentence</h3>
          <p>
            Most firms run discovery to learn your business well enough to start
            building. We&rsquo;re after something narrower and harder: the one
            sentence that, if it turned out to be false, would mean the whole
            project wasn&rsquo;t worth doing. Finding it is the real work of the
            first weeks.
          </p>
          <p>
            The move is simple and slightly uncomfortable. Whatever you first
            ask for, we treat as a symptom rather than the problem, and we keep
            asking what it gets you, one level at a time, until we reach
            something with a number attached. A feature becomes a workflow
            becomes a cost becomes a margin becomes the thing your board
            actually asked you about. Most conversations stop three questions
            too early, at the feature. We don&rsquo;t stop until the answer is
            something the business would feel.
          </p>
          <p>
            And the reason this matters isn&rsquo;t insight for its own sake.
            That sentence becomes the tie&#8209;breaker for everything after it.
            When two directions look equally good six weeks in, and they always
            do, we don&rsquo;t argue taste; we ask which one serves the
            sentence. Scope stops being a negotiation of opinions and becomes a
            test against something we already agreed was true. That&rsquo;s what
            the first conversation actually buys you: not a plan, a standard to
            hold the plan to. And what we find doesn&rsquo;t live in a slide or
            someone&rsquo;s memory; we capture it in a system, increasingly with
            AI holding the threads, so month six still answers to the sentence
            we found in week one.
          </p>
        </div>
      </div>

      <div class="row b" id="deeper-riskiest">
        <div class="lin">
          <div class="cur">Confidence</div><div class="sub-cur">Approach</div>
        </div><div class="col">
          <h3>Building the proof</h3>
          <p>
            Every build carries a handful of assumptions that, if they&rsquo;re
            wrong, change everything, and a hundred that don&rsquo;t matter. The
            skill isn&rsquo;t listing risks; anyone can produce a long column of
            worries. It&rsquo;s knowing which two or three actually decide
            whether this is viable, and having the discipline to set the rest
            aside for now.
          </p>
          <p>
            The test we use is narrow: if this assumption is false, does the
            initiative collapse, and are we currently building as though
            it&rsquo;s true? A risk that fails both is interesting but not
            urgent. A risk that passes both is where the whole thing lives, and
            it goes first. Usually it&rsquo;s something unglamorous: an
            integration under real load, a workflow users won&rsquo;t actually
            adopt, a constraint nobody has confirmed.
          </p>
          <p>
            Then, instead of analyzing it, we build it, and that swap is less
            obvious than it sounds. Talking about a risk changes how confident
            you feel without changing whether it&rsquo;s true; only contact with
            the real thing does that. So we make the smallest real version of
            the part most likely to break and put it under real conditions. A
            break in week two is a gift: it&rsquo;s the same break that costs
            you a quarter in month four, bought at a fraction of the price.
          </p>
          <p>
            That&rsquo;s also why the number holds. It&rsquo;s priced against
            things we&rsquo;ve watched work, not things we hope will, and
            what&rsquo;s still unproven we name as a bet, with a window to
            settle it, because an estimate honest about its own uncertainty is
            worth more than a confident one that&rsquo;s wrong. There&rsquo;s a
            name for this discipline, we call it Evidence Work, and it&rsquo;s
            the spine the rest of how we operate hangs on.
          </p>
          <button class="godeep" data-silo="riskiest"
            >&larr;&nbsp; A deeper dive into this one</button
          >
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="cur">Calm</div><div class="sub-cur">Approach</div>
        </div><div class="col">
          <h3>The loop never closes</h3>
          <p>
            The transparency isn&rsquo;t a reporting habit we impose on
            ourselves; it&rsquo;s a side effect of how the work is built. When
            the thing is always in a state you can run and look at,
            there&rsquo;s nothing to hide, because there&rsquo;s no gap between
            what&rsquo;s true and what&rsquo;s shown. Status meetings exist to
            close that gap. We just don&rsquo;t have the gap.
          </p>
          <p>
            And the questioning that killed the early risks never gets switched
            off. Most firms treat discovery as a gate: prove enough to start,
            then put the questions down and execute the plan. The trouble is
            that reality keeps arriving after the plan is set, and by then
            nobody is looking for it. We keep the same loop running the whole
            way; it just moves to smaller, later questions as the big ones die.
            We&rsquo;ve even begun building tools that do some of that watching
            for us, AI that reads the work as it moves and surfaces the
            assumption everyone quietly stopped checking, while it&rsquo;s still
            small.
          </p>
          <p>
            Here is the part that changes how the whole thing feels. On a
            traditional project, confidence is highest at kickoff (the plan is
            fresh, nothing has gone wrong yet), and it decays as reality shows
            up. Ours runs the other direction: lowest at the start, when we know
            the least, and climbing every week as questions get answered against
            something real. That&rsquo;s why, around week six, you notice
            you&rsquo;ve stopped bracing. It isn&rsquo;t reassurance. It&rsquo;s
            your confidence finally pointing the same way as the facts.
          </p>
        </div>
      </div>

      <div class="row b">
        <div class="lin">
          <div class="cur">Empowered</div><div class="sub-cur">Approach</div>
        </div><div class="col">
          <h3>What becomes possible</h3>
          <p>
            The most valuable thing you leave with isn&rsquo;t the software, or
            even the understanding underneath it. It&rsquo;s a changed sense of
            what&rsquo;s possible. Most engagements quietly lower your ceiling:
            you come out having learned, in expensive detail, how hard and slow
            the thing turned out to be. This one raises it.
          </p>
          <p>
            Think about the idea that got laughed out of the room, the one you
            filed under &lsquo;someday,&rsquo; or &lsquo;too risky to
            touch,&rsquo; or &lsquo;maybe when we&rsquo;re bigger.&rsquo; After
            building this way, you look at it differently, because you&rsquo;ve
            now watched the scariest part of a real build get de-risked in weeks
            and actually ship. Your gut sense of what&rsquo;s hard and
            what&rsquo;s reachable has been recalibrated against something real,
            and the thing that felt like a moonshot starts to look like a plan.
          </p>
          <p>
            And it isn&rsquo;t only that you feel bolder; you&rsquo;re equipped
            to act on it. Your people were in the room when the hard calls got
            made, so they understand why the system works, not just that it
            does; the architecture underneath is clean enough to build the next
            thing on. The ambition and the means to chase it arrive together,
            which is the rare part.
          </p>
          <p>
            That&rsquo;s also why we treat any dependency you&rsquo;re left with
            as a defect, not a feature. For most firms the next call you have to
            make is the business model; here it&rsquo;s a choice you get to make
            freely, including whether the next thing needs us at all. And
            because the reasoning behind every decision was captured as we went,
            not reconstructed at the end, what your team inherits is the <em
              >why</em
            >, not just the <em>what</em>.
          </p>
        </div>
      </div>
    </div><!-- /.doc-wrap -->

    <!-- ===== SILO · third level ===== -->
    <div class="silo" id="silo-riskiest">
      <button class="silo-back">&larr;&nbsp; Back to the narrative</button>
      <main class="silo-main">
        <h2>How it actually works</h2>

        <p>
          Early work has two jobs, not one. It has to find out whether the
          hard thing can be built, and whether it&rsquo;s the right thing to
          build at all. Most of what follows is one discipline serving both.
        </p>
        <p>
          Start with the word <em>riskiest</em>, because it&rsquo;s doing
          precise work. On most projects, risk gets spread evenly, every
          requirement treated as roughly equal, worked in the order someone
          wrote it down. We don&rsquo;t. Before anything gets built, we separate
          the handful of assumptions that would actually break the initiative if
          they&rsquo;re wrong from the hundred that wouldn&rsquo;t. Some of
          those are feasibility risks: whether the hard part can be built.
          Others are direction risks: whether this is even the thing worth
          building. Two or three of them, of either kind, usually decide
          whether the whole initiative is viable. Those go first.
        </p>
        <p>
          <em>First</em> doesn&rsquo;t mean we discuss them first. It means we build
          them first. For the top assumption we make the smallest real version of
          the thing most likely to fail, the hard part itself, running. And we decide,
          before we build it, what would count as it working and what would
          count as it failing: a build with no predefined bar produces a demo and
          a round of opinions; a build with a bar produces a result.
        </p>
        <p>
          But the build does a second thing at the same time, and it&rsquo;s
          the half that makes this consulting rather than a validation lab. A
          working artifact in front of a client changes the strategic
          conversation in a way no document can. An abstract question (which
          segment to serve, which direction to commit to, what the product
          should even be) stays abstract on a slide and gets decided the
          moment there&rsquo;s something real to react to. So we put the
          thing in front of the client early, on purpose. Not to demo it. To
          force a direction&#8209;level decision into the open while
          it&rsquo;s still cheap to change our minds.
        </p>
        <p>
          That means signal comes in two forms, and both matter. There&rsquo;s
          the instrumented result: did the hard part work, against the bar we
          set. And there&rsquo;s the strategic signal: what the client, seeing
          it real, now understands they actually want; which direction
          suddenly looks wrong; the question the prototype surfaced that
          nobody knew to ask. The first earns confidence that we can build it.
          The second earns confidence that it&rsquo;s the right thing to
          build.
        </p>
        <p>
          One discipline holds across both, and it&rsquo;s what keeps the
          strategic conversation from collapsing into the demo we just warned
          against: it still ends in a recorded decision. A working thing can
          produce a wonderful discussion and no decision; that&rsquo;s a
          demo. We require the direction conversation to close on an explicit
          call (commit to this direction, adjust it, or drop it) the same way
          we require the technical result to clear a bar. Opinions
          don&rsquo;t move the initiative. Recorded decisions do.
        </p>
        <p>
          That&rsquo;s why capabilities don&rsquo;t move in lockstep.
          Confidence is earned per question, on both axes, so a capability
          proven on feasibility and settled on direction enters real build,
          hardened and scoped, while one that&rsquo;s still an open question
          keeps getting tested. You are never scaling investment on
          something you haven&rsquo;t proven you can build or decided is
          worth building. It&rsquo;s also why the number holds: proven work
          is priced tight, and what&rsquo;s still a bet, feasibility or
          direction, is named as a bet, with a window to settle it.
        </p>

        <div class="sub">The capabilities at work</div>

        <div class="cap">
          <div class="nm">Risk framing</div>
          <span class="r"
            ><span class="lbl">Why it&rsquo;s here</span>You can&rsquo;t build
            the riskiest thing first until you know which thing is riskiest,
            and risk isn&rsquo;t only technical. This separates the two or
            three collapse&#8209;level assumptions (whether it can be built,
            and whether it&rsquo;s the right thing to build) from the hundred
            that don&rsquo;t move the investment, ranked by impact if wrong,
            uncertainty, and cost to test.</span
          >
          <span class="r out"
            ><span class="lbl">Produces</span>A prioritized shortlist of the
            assumptions that govern the commitment, feasibility and direction
            alike.</span
          >
        </div>
        <div class="cap">
          <div class="nm">Thin&#8209;slice engineering</div>
          <span class="r"
            ><span class="lbl">Why it&rsquo;s here</span>The fastest way to
            know whether the hard part works is to build it: the smallest
            real, instrumented version of the thing most likely to break, not
            a mockup of the easy screens. And where the risk is about
            direction or value, that same slice is the artifact we put in
            front of the client, real enough to provoke a sharper strategic
            decision than any deck would. Where the risk is behavioral, the
            slice is a working prototype real users touch.</span
          >
          <span class="r out"
            ><span class="lbl">Produces</span>A running artifact that
            generates real signal early: technical signal against a bar, and
            strategic signal from a client reacting to something real, before
            architecture is committed.</span
          >
        </div>
        <div class="cap">
          <div class="nm">Signal definition &amp; instrumentation</div>
          <span class="r"
            ><span class="lbl">Why it&rsquo;s here</span>A slice with no
            predefined bar produces a demo and opinions. This sets, in
            advance, what counts as success and failure on feasibility, and
            what decision the strategic conversation has to reach on
            direction, then wires the slice to surface both.</span
          >
          <span class="r out"
            ><span class="lbl">Produces</span>A clean, assumption&#8209;linked
            result on both axes: evidence rather than enthusiasm, and a
            direction call rather than a round of reactions.</span
          >
        </div>
        <div class="cap">
          <div class="nm">Confidence evaluation</div>
          <span class="r"
            ><span class="lbl">Why it&rsquo;s here</span>Signal only matters if
            it changes a decision. This judges signal against the evidence the
            next commitment demands (the more irreversible the step, the higher
            the bar) and records an explicit promote, iterate, pivot, or stop:
            on whether we can build it, and on whether we should.</span
          >
          <span class="r out"
            ><span class="lbl">Produces</span>A logged decision that earns real
            build or redirects the effort, on feasibility and direction both.
            No silent scaling.</span
          >
        </div>
        <div class="cap">
          <div class="nm">Confidence&#8209;based estimation</div>
          <span class="r"
            ><span class="lbl">Why it&rsquo;s here</span>The number holds only
            if it reflects what&rsquo;s known. This prices proven capabilities
            tight, buffers the directional ones, and puts explicit windows on
            what&rsquo;s still unsettled, technically or strategically.</span
          >
          <span class="r out"
            ><span class="lbl">Produces</span>An estimate traceable to signal,
            honest about fact versus bet.</span
          >
        </div>
        <div class="cap-note">
          These run as one loop, not a sequence: framing points at the risk, a
          slice generates signal against a predefined bar and provokes the
          direction decision, evaluation turns both into a recorded call, and
          estimation prices what the decision made true. The loop repeats at
          the next&#8209;highest risk until there&rsquo;s enough earned
          confidence (that it works, and that it&rsquo;s right) to commit.
        </div>

        <p>
          Ownership works the same way. The right capability is applied by
          whoever can clear the bar the work demands, not by a fixed title.
          What doesn&rsquo;t move is the decision: each commitment has one
          owner accountable for the call to promote, pivot, or stop.
        </p>
      </main>
    </div>

    <script is:inline>
      const body = document.body;
      let flyer = null,
        ph = null,
        home = null,
        homeRect = null;

      document.querySelectorAll(".godeep").forEach((a) =>
        a.addEventListener("click", (e) => {
          e.preventDefault();
          openSilo(a);
        }),
      );
      document.querySelector(".silo-back").addEventListener("click", closeSilo);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && body.classList.contains("silo-open"))
          closeSilo();
      });

      function openSilo(btn) {
        const col = btn.closest(".col");
        if (!col || flyer) return;
        const r = col.getBoundingClientRect();
        flyer = col;
        home = col.parentNode;
        homeRect = r;
        ph = document.createElement("div");
        ph.style.height = r.height + "px";
        ph.className = "fly-ph";
        home.insertBefore(ph, col);
        col.dataset.tier = "Approach";
        body.appendChild(col);
        col.classList.add("flying");
        col.style.top = r.top + "px";
        col.style.left = r.left + "px";
        col.style.width = r.width + "px";
        col.style.maxHeight = r.height + "px";
        body.classList.add("silo-open");
        const s = document.querySelector(".silo");
        if (s) s.scrollTop = 0;
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            col.classList.add("ref-mode");
            col.style.top = "72px";
            col.style.left = "44px";
            col.style.width = "320px";
            col.style.maxHeight = "150px";
          }),
        );
      }

      function closeSilo() {
        body.classList.remove("silo-open");
        if (!flyer || !ph) return;
        const col = flyer,
          placeholder = ph,
          homeParent = home,
          r = homeRect;
        flyer = null;
        ph = null;
        col.classList.remove("ref-mode");
        col.style.top = r.top + "px";
        col.style.left = r.left + "px";
        col.style.width = r.width + "px";
        col.style.maxHeight = r.height + "px";
        setTimeout(() => {
          col.classList.remove("flying");
          col.removeAttribute("style");
          delete col.dataset.tier;
          homeParent.insertBefore(col, placeholder);
          placeholder.remove();
        }, 950);
      }
    </script>
  </body>
</html>
