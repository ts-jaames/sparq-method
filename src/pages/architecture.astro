/* ──────────────────────────────────────────────────────────────
   INDEXES
   ────────────────────────────────────────────────────────────── */
var byId = {};
NODES.forEach(function (n) { byId[n.id] = n; });

function relations(id) {
  var out = [], inn = [], both = [];
  EDGES.forEach(function (e) {
    var a = e[0], b = e[1], bi = e[2] === '<>', verb = e[3] || 'informs';
    if (bi) {
      if (a === id) both.push({ id: b, verb: verb });
      else if (b === id) both.push({ id: a, verb: verb });
    } else {
      if (a === id) out.push({ id: b, verb: verb });
      else if (b === id) inn.push({ id: a, verb: verb });
    }
  });
  return { out: out, inn: inn, both: both };
}

function edgeSentence(e) {
  var a = byId[e[0]].name, b = byId[e[1]].name, verb = e[3] || 'informs';
  return e[2] === '<>' ? a + ' ↔ ' + b + ' — each informs the other' : a + ' ' + verb + ' ' + b;
}

