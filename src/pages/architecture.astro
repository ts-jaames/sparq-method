<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SparqOS relationships</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:inline>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg: #1A1A1A;
  --bg2: #222222;
  --bg3: #2a2a2a;
  --text: #E5E5E5;
  --text2: rgba(229,229,229,0.6);
  --text3: rgba(229,229,229,0.35);
  --border: rgba(229,229,229,0.08);
  --border2: rgba(229,229,229,0.14);
  --green: #35B98F;
  --green-dim: rgba(53,185,143,0.08);
  --green-border: rgba(53,185,143,0.3);
  --purple: #B0AAEE;
  --purple-dim: rgba(127,119,221,0.08);
  --purple-border: rgba(127,119,221,0.3);
  --amber: #F4B84A;
  --amber-dim: rgba(239,159,39,0.08);
  --amber-border: rgba(239,159,39,0.28);
  --red: #E87070;
  --red-dim: rgba(226,75,74,0.08);
  --red-border: rgba(226,75,74,0.28);
  --domain: #7BB2D4;
  --domain-dim: rgba(123,178,212,0.08);
  --domain-border: rgba(123,178,212,0.3);
  --grey: #9A9A9A;
  --font: 'Host Grotesk', sans-serif;
  --mono: 'IBM Plex Mono', monospace;
}
html, body {
  width: 100%; min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
}

/* ── HEADER ── */
header {
  padding: 36px 48px 24px;
  border-bottom: 0.5px solid var(--border);
  display: flex; align-items: flex-start; justify-content: space-between;
  flex-wrap: wrap; gap: 24px;
}
.header-left h1 {
  font-size: 28px; font-weight: 500; letter-spacing: -0.01em;
  margin-bottom: 8px;
}
.header-left p {
  font-size: 14px; color: var(--text2); max-width: 620px; line-height: 1.6;
}
.header-right {
  display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
}
.legend { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
.legend-item {
  display: flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: 10px; letter-spacing: .06em;
  text-transform: uppercase; color: var(--text3);
}
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.control-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; }
.control-label {
  font-family: var(--mono); font-size: 9px; letter-spacing: .06em;
  text-transform: uppercase; color: var(--text3);
}
.pill {
  font-family: var(--mono); font-size: 10px; letter-spacing: .05em;
  padding: 5px 12px;
  border-radius: 100px; border: 0.5px solid var(--border2);
  background: none; color: var(--text3); cursor: pointer;
  transition: all .2s;
}
.pill:hover { color: var(--text); border-color: var(--border2); }
.pill.lens { border-color: var(--purple-border); }
.pill.lens:hover { color: var(--purple); }
.pill.lens.active { background: var(--purple-dim); border-color: var(--purple-border); color: var(--purple); }
.pill.view.active { background: rgba(229,229,229,0.08); border-color: var(--border2); color: var(--text); }

/* ── MAIN LAYOUT ── */
main {
  display: grid;
  grid-template-columns: 1fr 360px;
  min-height: calc(100vh - 190px);
}

/* ── DIAGRAM ── */
.diagram { padding: 28px 32px 40px; overflow: auto; }
main.view-list .diagram { display: none; }
main:not(.view-list) .list-wrap { display: none; }

.canvas {
  position: relative;
  width: 990px; height: 900px;
  margin: 0 auto;
}
#edges {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  z-index: 0; overflow: visible;
}
.band-label {
  position: absolute; z-index: 0;
  font-family: var(--mono); font-size: 9px; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(229,229,229,0.18);
  white-space: nowrap; pointer-events: none;
}

/* ── EDGES ── */
.edge-line { fill: none; stroke: rgba(229,229,229,0.22); stroke-width: 1; transition: stroke .2s, stroke-width .2s; }
.edge-hit { fill: none; stroke: transparent; stroke-width: 14px; cursor: help; }
.edge { transition: opacity .25s; }
.edge.dim { opacity: 0.06; }
.edge.active .edge-line { stroke-width: 1.6; }
.edge:hover .edge-line { stroke: var(--text) !important; stroke-width: 1.8; }

/* ── NODES ── */
.node {
  position: absolute; z-index: 1;
  width: 170px;
  border-radius: 8px; padding: 10px 12px;
  border: 0.5px solid var(--border2);
  background: var(--bg2);
  cursor: pointer;
  transition: opacity .25s, transform .2s, box-shadow .2s;
}
.node:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.35); }
.node:focus-visible { outline: 1.5px solid var(--text); outline-offset: 2px; }
.node-name {
  font-size: 12px; font-weight: 500; line-height: 1.3;
  margin-bottom: 3px; color: var(--text);
}
.node-sub {
  font-family: var(--mono); font-size: 9px; letter-spacing: .03em;
  color: var(--text3); line-height: 1.4;
}
.node.dim { opacity: 0.12; }
.node.dim:hover { opacity: 0.25; transform: none; box-shadow: none; }

.open-flag {
  display: inline-block; font-family: var(--mono); font-size: 8px;
  letter-spacing: .06em; text-transform: uppercase;
  padding: 2px 6px; border-radius: 3px; margin-top: 6px;
  background: rgba(239,159,39,0.16); color: var(--amber);
  border: 0.5px solid var(--amber-border);
}

.node-found { background: var(--amber-dim); border-color: var(--amber-border); }
.node-found .node-name { color: var(--amber); }
.node-delivery { background: var(--purple-dim); border-color: var(--purple-border); }
.node-delivery .node-name { color: var(--purple); }
.node-store { background: var(--domain-dim); border-color: var(--domain-border); }
.node-store .node-name { color: var(--domain); }
.node-surface { background: var(--green-dim); border-color: var(--green-border); }
.node-surface .node-name { color: var(--green); }
.node-gtm { background: var(--red-dim); border-color: var(--red-border); }
.node-gtm .node-name { color: var(--red); }
.node-external { background: rgba(229,229,229,0.02); border-color: var(--border); border-style: dashed; }
.node-external .node-name { color: var(--text2); }

/* ── SIDEBAR ── */
.sidebar {
  border-left: 0.5px solid var(--border);
  background: var(--bg2);
  overflow-y: auto;
}
.sidebar-section { padding: 20px 24px; border-bottom: 0.5px solid var(--border); }
.sidebar-title {
  font-family: var(--mono); font-size: 9px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--text3); margin-bottom: 12px;
}
.detail-empty { font-size: 12px; color: var(--text3); line-height: 1.6; font-style: italic; }
#node-detail { display: none; }
#node-detail.visible { display: block; }
.detail-name { font-size: 15px; font-weight: 500; margin-bottom: 6px; line-height: 1.35; }
.detail-kind {
  font-family: var(--mono); font-size: 9px; letter-spacing: .07em;
  text-transform: uppercase; color: var(--text3); margin-bottom: 10px;
}
.detail-desc { font-size: 13px; color: var(--text2); line-height: 1.6; margin-bottom: 14px; }
.detail-bullets { list-style: none; padding: 0; margin: 0 0 14px; }
.detail-bullets li {
  font-size: 12px; color: var(--text2); line-height: 1.6;
  padding-left: 12px; position: relative; margin-bottom: 10px;
  padding-bottom: 10px; border-bottom: 0.5px solid var(--border);
}
.detail-bullets li:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.detail-bullets li::before { content: '·'; position: absolute; left: 0; color: var(--text3); }
.detail-meta { display: flex; flex-direction: column; gap: 12px; }
.meta-row { display: flex; flex-direction: column; gap: 5px; }
.meta-label {
  font-family: var(--mono); font-size: 9px; letter-spacing: .07em;
  text-transform: uppercase; color: var(--text3);
}
.chip-list { display: flex; flex-wrap: wrap; gap: 4px; }
.chip {
  display: inline-block; font-size: 10px; font-weight: 500;
  padding: 2px 8px; line-height: 1.5;
  border-radius: 10px; border: 0.5px solid var(--border2);
  background: var(--bg); color: var(--text2);
  cursor: pointer; transition: opacity .2s;
}
.chip:hover { opacity: 0.75; }
.chip-found { background: var(--amber-dim); border-color: var(--amber-border); color: var(--amber); }
.chip-delivery { background: var(--purple-dim); border-color: var(--purple-border); color: var(--purple); }
.chip-store { background: var(--domain-dim); border-color: var(--domain-border); color: var(--domain); }
.chip-surface { background: var(--green-dim); border-color: var(--green-border); color: var(--green); }
.chip-gtm { background: var(--red-dim); border-color: var(--red-border); color: var(--red); }
.chip-external { background: rgba(229,229,229,0.02); border-color: var(--border); color: var(--text3); }

.def-row { margin-bottom: 12px; }
.def-row:last-child { margin-bottom: 0; }
.def-term { font-size: 12px; font-weight: 500; color: var(--text); margin-bottom: 3px; }
.def-body { font-size: 12px; color: var(--text2); line-height: 1.55; }

.open-card {
  padding: 10px 12px; border-radius: 6px;
  background: var(--amber-dim); border: 0.5px solid var(--amber-border);
  margin-bottom: 8px;
}
.open-card:last-child { margin-bottom: 0; }
.open-card-label {
  font-family: var(--mono); font-size: 9px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--amber); margin-bottom: 5px;
}
.open-card-text { font-size: 12px; color: var(--text2); line-height: 1.55; }

/* ── LIST VIEW ── */
.list-wrap { padding: 28px 40px 48px; max-width: 900px; }
.list-intro { font-size: 13px; color: var(--text2); line-height: 1.6; margin-bottom: 24px; max-width: 620px; }
.list-group { margin-bottom: 26px; padding-bottom: 20px; border-bottom: 0.5px solid var(--border); }
.list-group:last-child { border-bottom: none; }
.list-group-name { font-size: 15px; font-weight: 500; margin-bottom: 3px; }
.list-group-sub {
  font-family: var(--mono); font-size: 9px; letter-spacing: .05em;
  text-transform: uppercase; color: var(--text3); margin-bottom: 12px;
}
.rel { display: flex; gap: 10px; align-items: baseline; padding: 4px 0; }
.rel-arrow {
  font-family: var(--mono); font-size: 11px; color: var(--text3);
  width: 22px; flex-shrink: 0;
}
.rel-arrow.bi { color: var(--purple); }
.rel-text { font-size: 13px; color: var(--text2); line-height: 1.5; }
.rel-none { font-size: 12px; color: var(--text3); font-style: italic; }

footer {
  padding: 18px 48px;
  border-top: 0.5px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 12px;
}
.footer-text {
  font-family: var(--mono); font-size: 10px; letter-spacing: .05em;
  color: var(--text3); text-transform: uppercase;
}

@media (max-width: 1100px) {
  main { grid-template-columns: 1fr; }
  .sidebar { border-left: none; border-top: 0.5px solid var(--border); }
}
</style>
</head>
<body>

<header>
  <div class="header-left">
    <h1>SparqOS relationships</h1>
    <p>Not a hierarchy — a set of things that inform each other. Every line is a claim about direction: who feeds whom, and where the feed runs both ways. ADLC is the engine in the middle; the store is the memory underneath it; GTM is what the two of them make sellable. Click any node to isolate what it touches.</p>
  </div>
  <div class="header-right">
    <div class="legend" id="legend"></div>
    <div class="control-row" id="view-select"></div>
    <div class="control-row" id="lens-select"></div>
  </div>
</header>

<main id="main">
  <div class="diagram">
    <div class="canvas" id="canvas">
      <svg id="edges"></svg>
    </div>
  </div>

  <div class="list-wrap">
    <div class="list-intro">Every relationship on the map, written out. <span style="color:var(--purple)">↔</span> marks a loop — both sides inform each other. This list and the map are generated from the same source, so they cannot drift apart.</div>
    <div id="list-body"></div>
  </div>

  <div class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-title">Selection</div>
      <div id="node-placeholder" class="detail-empty">Click any node — or any lens — to see what it informs, what informs it, and where the relationship runs both ways.</div>
      <div id="node-detail"></div>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-title">The two stores</div>
      <div class="def-row">
        <div class="def-term">SPOT — the data lake</div>
        <div class="def-body">The store of what happened in Sparq history. The record, not the reading of it.</div>
      </div>
      <div class="def-row">
        <div class="def-term">Institutional intelligence</div>
        <div class="def-body">The store of what the data lake teaches. The reading, not the record.</div>
      </div>
      <div class="def-row">
        <div class="def-term">Context flow / retrieval</div>
        <div class="def-body">Neither store — the layer that gets what is stored in front of the work.</div>
      </div>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-title">Open questions</div>
      <div id="open-body"></div>
    </div>
  </div>
</main>

<footer>
  <div class="footer-text">The Sparq Method · SparqOS relationship map · v0.2</div>
  <div class="footer-text" id="edge-count"></div>
</footer>

<script is:inline>
/* ──────────────────────────────────────────────────────────────
   CATEGORIES
   ────────────────────────────────────────────────────────────── */
var CATS = {
  found:    { label: 'Capability & talent', color: '#F4B84A' },
  delivery: { label: 'Delivery',            color: '#B0AAEE' },
  store:    { label: 'Store & flow',        color: '#7BB2D4' },
  surface:  { label: 'Client surface',      color: '#35B98F' },
  gtm:      { label: 'GTM & commercial',    color: '#E87070' },
  external: { label: 'Outside SparqOS',     color: '#9A9A9A' }
};

/* ──────────────────────────────────────────────────────────────
   NODES  (x/y = position on the 1190x900 canvas)
   ────────────────────────────────────────────────────────────── */
var NODES = [
  {
    id: 'cap', name: 'Capability model', sub: 'what we can do, evidenced',
    cat: 'found', x: 30, y: 250,
    desc: 'What Sparq can do, at what level, and how that is evidenced. It sits upstream of nearly everything: it informs who we hire and place, how the work is run, what we sell, and what we charge. Two of those relationships run back the other way — ADLC and Solutions are where the model gets corrected by contact with reality.'
  },
  {
    id: 'talent', name: 'Talent & resourcing', sub: 'who does the work',
    cat: 'found', x: 30, y: 430,
    desc: 'Who we put on the work, and how we source and place them. Downstream of the capability model, in a loop with both ADLC (delivery shows what the staffing actually needs to be) and commercials (what we can staff sets what we can price, and what we price sets what we can staff).'
  },
  {
    id: 'shop', name: 'The Shop', sub: 'definition open',
    cat: 'delivery', x: 280, y: 60, open: true,
    desc: 'Currently reads as a build space that feeds GTM IQs & accelerators. Drawn in a loop with ADLC on the assumption that it is a playground where new ways of working get found — if it turns out to be an output channel only, that back-edge comes off the map.',
    note: 'Still unresolved: what The Shop is, and what it turns into.'
  },
  {
    id: 'adlc', name: 'ADLC', sub: 'how the work moves',
    cat: 'delivery', x: 280, y: 260,
    desc: 'The engine. ADLC generates the evidence that lands in the data lake, drives the client experience surface, and produces the raw material for GTM IQs & accelerators. Almost every relationship it has runs both ways — the capability model, Solutions, commercials, talent, The Shop and institutional intelligence all shape delivery and get reshaped by it.'
  },
  {
    id: 'spot', name: 'SPOT', sub: 'the data lake',
    cat: 'store', x: 280, y: 620,
    desc: 'The store of what happened in Sparq history. ADLC writes the evidence into it, the client experience surface writes interactions into it, and the retrieval layer reads out of it. In a loop with institutional intelligence: the lake teaches, and what is learned is written back.',
    note: 'Open: is a per-engagement store needed as its own object, or does SPOT cover that too?'
  },
  {
    id: 'gtm', name: 'GTM IQs & accelerators', sub: 'packaged proof',
    cat: 'gtm', x: 530, y: 60,
    desc: 'The reusable, packaged form of what Sparq already knows how to do. Fed by ADLC (what delivery proves), by The Shop (what gets built there), and by institutional intelligence (what the record teaches). Feeds commercials.'
  },
  {
    id: 'ii', name: 'Institutional intelligence', sub: 'what the lake teaches',
    cat: 'store', x: 530, y: 430,
    desc: 'The store of what the data lake teaches — the patterns, benchmarks and judgment extracted from the record. It is not the record. It informs Solutions and GTM IQs & accelerators, is in a loop with ADLC, and is in a loop with the store it reads from.'
  },
  {
    id: 'flow', name: 'Context flow', sub: 'retrieval layer',
    cat: 'store', x: 530, y: 620,
    desc: 'The layer between the store and the work. It reads from SPOT and puts context in front of the client experience surface. It stores nothing itself — which is exactly why it is drawn separately from the lake.'
  },
  {
    id: 'solutions', name: 'Solutions', sub: 'the promise',
    cat: 'gtm', x: 780, y: 230,
    desc: 'What Sparq takes to market. Shaped from three directions — the capability model (what we can credibly claim), ADLC (what delivery can actually carry), and institutional intelligence (what the record says works) — and proven by the client experience surface. It informs commercials and, in return, commercials shapes it.'
  },
  {
    id: 'cx', name: 'Client experience surface', sub: 'where the client meets the work',
    cat: 'surface', x: 780, y: 400,
    desc: 'Where the client meets the work. Fed by ADLC and by the retrieval layer. Two things flow out of it: client interactions become signal back into the store, and the experience itself becomes the proof of the promise Solutions makes.'
  },
  {
    id: 'comm', name: 'Commercials', sub: 'how it is priced and packaged',
    cat: 'gtm', x: 780, y: 60,
    desc: 'How the work is priced and packaged. The convergence point: the capability model, talent, ADLC, Solutions and GTM IQs & accelerators all feed it. Three of those are loops — commercials pushes back on talent, ADLC and Solutions.'
  },
  {
    id: 'studio', name: 'Intelligence Studio', sub: 'embedded in client systems',
    cat: 'gtm', x: 780, y: 620, open: true,
    desc: 'Embedded externally, in the client’s own systems — deliberately distinct from the client experience surface, which is Sparq’s surface. Drawn with one relationship out and none in.',
    note: 'Open: what feeds Intelligence Studio — GTM IQs, institutional intelligence, ADLC? Undrawn for now.'
  },
  {
    id: 'clientsys', name: 'Client’s own systems', sub: 'outside Sparq’s surface',
    cat: 'external', x: 780, y: 790,
    desc: 'Not part of SparqOS. On the map because Intelligence Studio reaches into it — that is the distinction being drawn between something embedded in the client’s estate and something the client visits on ours.'
  }
];

/* ──────────────────────────────────────────────────────────────
   EDGES  [from, to, '>' one-way | '<>' both ways]
   ────────────────────────────────────────────────────────────── */
var EDGES = [
  /* capability model */
  ['cap', 'talent', '>'],
  ['cap', 'adlc', '<>'],
  ['cap', 'comm', '>'],
  ['cap', 'solutions', '<>'],
  /* talent & resourcing */
  ['talent', 'comm', '<>'],
  ['talent', 'adlc', '<>'],
  /* ADLC */
  ['adlc', 'cx', '>'],
  ['adlc', 'gtm', '>'],
  ['adlc', 'solutions', '<>'],
  ['adlc', 'comm', '<>'],
  ['adlc', 'spot', '>'],
  ['adlc', 'shop', '<>'],
  ['adlc', 'ii', '<>'],
  /* store and flow */
  ['spot', 'flow', '>'],
  ['flow', 'cx', '>'],
  ['spot', 'ii', '<>'],
  /* client experience surface */
  ['cx', 'spot', '>'],
  ['cx', 'solutions', '>'],
  /* GTM */
  ['solutions', 'comm', '<>'],
  ['ii', 'gtm', '>'],
  ['gtm', 'comm', '>'],
  ['ii', 'solutions', '>'],
  ['studio', 'clientsys', '>'],
  /* the shop */
  ['shop', 'gtm', '>']
];

/* ──────────────────────────────────────────────────────────────
   OPEN QUESTIONS
   ────────────────────────────────────────────────────────────── */
var OPEN = [
  {
    label: 'Per-engagement store',
    text: 'SPOT is defined here as the history-wide lake. Is a per-engagement store needed as its own object — the live state of one engagement — or is SPOT doing that job as well? If it is separate, it belongs on this map between ADLC and SPOT. An earlier version of this page carried a per-engagement evidence layer as a distinct thing; this version does not.',
    focus: ['spot', 'adlc']
  },
  {
    label: 'The Shop',
    text: 'Still unsure what The Shop is or what it becomes. It is drawn feeding GTM IQs & accelerators, and in a loop with ADLC on the reading that it is a playground where new ways of working get identified. If it is only an output channel, the ADLC back-edge is wrong.',
    focus: ['shop', 'adlc', 'gtm']
  },
  {
    label: 'Intelligence Studio',
    text: 'One relationship out — into the client’s own systems — and nothing in. Whatever feeds it (GTM IQs, institutional intelligence, ADLC) is not yet called, so it sits deliberately unconnected rather than guessed at.',
    focus: ['studio', 'clientsys']
  }
];

/* ──────────────────────────────────────────────────────────────
   LENSES
   ────────────────────────────────────────────────────────────── */
var LENSES = [
  {
    id: 'evidence',
    label: 'Evidence loop',
    nodes: ['adlc', 'spot', 'flow', 'cx', 'ii'],
    explanation: '<div class="detail-name">Evidence loop</div><div class="detail-kind">Lens</div><div class="detail-desc">The closed circuit: delivery produces evidence, the lake keeps it, the retrieval layer serves it, the client surface uses it — and what happens there goes back into the lake.</div><ul class="detail-bullets"><li><strong>The path:</strong> ADLC writes evidence into SPOT. SPOT feeds the retrieval layer. Retrieval feeds the client experience surface. The surface writes interactions back into the store. Institutional intelligence sits across the loop, reading the lake and being read by ADLC.</li><li><strong>Why it matters:</strong> this is the only loop on the map that closes without passing through a commercial or capability decision. It is the part of SparqOS that compounds on its own.</li><li><strong>Where it is thin:</strong> the loop assumes one store. If per-engagement state is really a separate object, it sits inside this loop, between ADLC and SPOT, and the circuit has a node missing.</li></ul>'
  },
  {
    id: 'spine',
    label: 'Capability spine',
    nodes: ['cap', 'talent', 'adlc', 'comm', 'solutions'],
    explanation: '<div class="detail-name">Capability spine</div><div class="detail-kind">Lens</div><div class="detail-desc">What Sparq can do, who does it, how it runs, what it is sold as, and what it costs — the load-bearing chain.</div><ul class="detail-bullets"><li><strong>The shape:</strong> the capability model is the only node here that is purely upstream of the others, and even it is corrected by ADLC and Solutions. Everything else in the spine is in at least one loop.</li><li><strong>Commercials is the convergence point:</strong> capability, talent, ADLC and Solutions all price through it, and it pushes back on three of the four.</li><li><strong>What to watch:</strong> a capability model that is not corrected by delivery becomes a brochure. The two bidirectional edges — ADLC and Solutions — are the ones that keep it honest.</li></ul>'
  },
  {
    id: 'gtm',
    label: 'GTM',
    nodes: ['solutions', 'gtm', 'studio', 'comm', 'ii', 'cx', 'clientsys'],
    explanation: '<div class="detail-name">GTM</div><div class="detail-kind">Lens</div><div class="detail-desc">The market-facing edge: Solutions as the promise, IQs and accelerators as packaged proof, commercials as the price, Intelligence Studio as the piece that lives in the client’s estate.</div><ul class="detail-bullets"><li><strong>Where the proof comes from:</strong> institutional intelligence feeds both Solutions and the IQs. The client experience surface is what actually proves the promise — GTM claims nothing the surface has not carried.</li><li><strong>Two different externals:</strong> the client experience surface is Sparq’s surface that the client meets. Intelligence Studio is embedded in the client’s own systems. Same market, different side of the boundary.</li><li><strong>The hole:</strong> Intelligence Studio has no inbound relationships drawn. Until they are called, it is a claim without a supply chain.</li></ul>'
  },
  {
    id: 'open',
    label: 'Open questions',
    nodes: ['shop', 'spot', 'studio', 'adlc', 'clientsys'],
    explanation: '<div class="detail-name">Open questions</div><div class="detail-kind">Lens</div><div class="detail-desc">The three places this map is asserting something it cannot yet defend.</div><ul class="detail-bullets"><li><strong>One store or two:</strong> SPOT is the history-wide lake. Whether a per-engagement store is a separate object is unresolved — and it changes the shape of the evidence loop.</li><li><strong>The Shop:</strong> feeding GTM IQs is clear enough. The loop back into ADLC rests on it being a playground that surfaces new ways of working. Not confirmed.</li><li><strong>Intelligence Studio:</strong> drawn with one edge out and none in.</li><li><strong>Read the rest as settled:</strong> everything not lit here is a relationship the map is willing to defend.</li></ul>'
  }
];

/* ──────────────────────────────────────────────────────────────
   INDEXES
   ────────────────────────────────────────────────────────────── */
var byId = {};
NODES.forEach(function (n) { byId[n.id] = n; });

function relations(id) {
  var out = [], inn = [], both = [];
  EDGES.forEach(function (e) {
    var a = e[0], b = e[1], bi = e[2] === '<>';
    if (bi) {
      if (a === id) both.push(b);
      else if (b === id) both.push(a);
    } else {
      if (a === id) out.push(b);
      else if (b === id) inn.push(a);
    }
  });
  return { out: out, inn: inn, both: both };
}

function edgeSentence(e) {
  var a = byId[e[0]].name, b = byId[e[1]].name;
  return e[2] === '<>' ? a + ' ↔ ' + b + ' — each informs the other' : a + ' informs ' + b;
}

/* ──────────────────────────────────────────────────────────────
   RENDER: legend, controls, nodes, list, open questions
   ────────────────────────────────────────────────────────────── */
(function renderLegend() {
  var html = '';
  Object.keys(CATS).forEach(function (k) {
    html += '<div class="legend-item"><span class="legend-dot" style="background:' + CATS[k].color + '"></span>' + CATS[k].label + '</div>';
  });
  document.getElementById('legend').innerHTML = html;
})();

(function renderViewToggle() {
  document.getElementById('view-select').innerHTML =
    '<span class="control-label">View</span>' +
    '<button class="pill view active" data-view="map" onclick="setView(\'map\', this)">Map</button>' +
    '<button class="pill view" data-view="list" onclick="setView(\'list\', this)">List</button>';
})();

(function renderLensButtons() {
  var html = '<span class="control-label">Lenses</span>';
  LENSES.forEach(function (l) {
    html += '<button class="pill lens" data-lens="' + l.id + '" onclick="toggleLens(\'' + l.id + '\', this)">' + l.label + '</button>';
  });
  document.getElementById('lens-select').innerHTML = html;
})();

(function renderNodes() {
  var canvas = document.getElementById('canvas');
  var html = '';
  NODES.forEach(function (n) {
    html += '<div class="node node-' + n.cat + '" id="n-' + n.id + '" data-id="' + n.id + '"' +
      ' style="left:' + n.x + 'px;top:' + n.y + 'px" tabindex="0" role="button"' +
      ' onclick="selectNode(\'' + n.id + '\')"' +
      ' onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();selectNode(\'' + n.id + '\')}">' +
      '<div class="node-name">' + n.name + '</div>' +
      '<div class="node-sub">' + n.sub + '</div>' +
      (n.open ? '<span class="open-flag">Open</span>' : '') +
      '</div>';
  });
  html += '<div class="band-label" style="left:32px;top:212px">Foundations</div>';
  html += '<div class="band-label" style="left:282px;top:22px">Delivery</div>';
  html += '<div class="band-label" style="left:532px;top:22px">Go to market</div>';
  html += '<div class="band-label" style="left:282px;top:582px">Store &amp; flow</div>';
  html += '<div class="band-label" style="left:782px;top:362px">Client surface</div>';
  html += '<div class="band-label" style="left:782px;top:752px">Outside SparqOS</div>';
  canvas.insertAdjacentHTML('beforeend', html);
})();

(function renderOpen() {
  var html = '';
  OPEN.forEach(function (q, i) {
    html += '<div class="open-card" onclick="focusOpen(' + i + ')" style="cursor:pointer">' +
      '<div class="open-card-label">' + q.label + '</div>' +
      '<div class="open-card-text">' + q.text + '</div></div>';
  });
  document.getElementById('open-body').innerHTML = html;
})();

(function renderList() {
  var html = '';
  NODES.forEach(function (n) {
    var r = relations(n.id);
    html += '<div class="list-group">';
    html += '<div class="list-group-name">' + n.name + '</div>';
    html += '<div class="list-group-sub">' + CATS[n.cat].label + ' · ' + n.sub + '</div>';
    if (r.out.length === 0 && r.inn.length === 0 && r.both.length === 0) {
      html += '<div class="rel-none">No relationships drawn.</div>';
    }
    r.out.forEach(function (t) {
      html += '<div class="rel"><span class="rel-arrow">→</span><span class="rel-text">informs <strong>' + byId[t].name + '</strong></span></div>';
    });
    r.both.forEach(function (t) {
      html += '<div class="rel"><span class="rel-arrow bi">↔</span><span class="rel-text">and <strong>' + byId[t].name + '</strong> inform each other</span></div>';
    });
    r.inn.forEach(function (t) {
      html += '<div class="rel"><span class="rel-arrow">←</span><span class="rel-text">informed by <strong>' + byId[t].name + '</strong></span></div>';
    });
    if (n.note) {
      html += '<div class="rel" style="margin-top:8px"><span class="rel-arrow" style="color:var(--amber)">?</span><span class="rel-text" style="color:var(--amber)">' + n.note + '</span></div>';
    }
    html += '</div>';
  });
  document.getElementById('list-body').innerHTML = html;
})();

document.getElementById('edge-count').textContent =
  NODES.length + ' nodes · ' + EDGES.length + ' relationships · ' +
  EDGES.filter(function (e) { return e[2] === '<>'; }).length + ' loops';

/* ──────────────────────────────────────────────────────────────
   EDGE DRAWING
   Quadratic curves, auto-routed: each edge tries increasing
   curvature until its path clears every node box it does not
   belong to.
   ────────────────────────────────────────────────────────────── */
var SVGNS = 'http://www.w3.org/2000/svg';
var MARKER_FILL = {
  idle: 'rgba(229,229,229,0.42)',
  found: CATS.found.color,
  delivery: CATS.delivery.color,
  store: CATS.store.color,
  surface: CATS.surface.color,
  gtm: CATS.gtm.color,
  external: CATS.external.color,
  lens: '#E5E5E5'
};
var BOWS = [0, 55, -55, 100, -100, 150, -150, 210, -210, 280, -280, 360, -360];
var SAMPLES = 72;
var edgeEls = [];

function el(tag, attrs) {
  var n = document.createElementNS(SVGNS, tag);
  Object.keys(attrs || {}).forEach(function (k) { n.setAttribute(k, attrs[k]); });
  return n;
}

function boxOf(id) {
  var e = document.getElementById('n-' + id);
  return { x: e.offsetLeft, y: e.offsetTop, w: e.offsetWidth, h: e.offsetHeight };
}

function inBox(b, p, pad) {
  return p.x > b.x - pad && p.x < b.x + b.w + pad && p.y > b.y - pad && p.y < b.y + b.h + pad;
}

function curvePoints(p1, p2, bow) {
  var dx = p2.x - p1.x, dy = p2.y - p1.y;
  var len = Math.sqrt(dx * dx + dy * dy) || 1;
  var c = { x: (p1.x + p2.x) / 2 + (-dy / len) * bow, y: (p1.y + p2.y) / 2 + (dx / len) * bow };
  var pts = [];
  for (var i = 0; i <= SAMPLES; i++) {
    var t = i / SAMPLES, u = 1 - t;
    pts.push({
      x: u * u * p1.x + 2 * u * t * c.x + t * t * p2.x,
      y: u * u * p1.y + 2 * u * t * c.y + t * t * p2.y
    });
  }
  return pts;
}

function trim(pts, ba, bb) {
  var s = 0, e = pts.length - 1;
  while (s < pts.length && inBox(ba, pts[s], 5)) s++;
  while (e > 0 && inBox(bb, pts[e], 5)) e--;
  if (s >= e) { s = 0; e = pts.length - 1; }
  return pts.slice(s, e + 1);
}

function drawEdges() {
  var svg = document.getElementById('edges');
  svg.innerHTML = '';
  edgeEls = [];

  var defs = el('defs', {});
  Object.keys(MARKER_FILL).forEach(function (k) {
    var m = el('marker', {
      id: 'arw-' + k, viewBox: '0 0 10 10', refX: '8.5', refY: '5',
      markerWidth: '7.5', markerHeight: '7.5', orient: 'auto-start-reverse'
    });
    m.appendChild(el('path', { d: 'M0,1.2 L8.5,5 L0,8.8 z', fill: MARKER_FILL[k] }));
    defs.appendChild(m);
  });
  svg.appendChild(defs);

  var boxes = {};
  NODES.forEach(function (n) { boxes[n.id] = boxOf(n.id); });

  EDGES.forEach(function (edge) {
    var a = edge[0], b = edge[1], bi = edge[2] === '<>';
    var ba = boxes[a], bb = boxes[b];
    var p1 = { x: ba.x + ba.w / 2, y: ba.y + ba.h / 2 };
    var p2 = { x: bb.x + bb.w / 2, y: bb.y + bb.h / 2 };

    var best = null, bestHits = Infinity;
    for (var i = 0; i < BOWS.length; i++) {
      var pts = trim(curvePoints(p1, p2, BOWS[i]), ba, bb);
      var hits = 0;
      for (var j = 0; j < pts.length; j++) {
        for (var k = 0; k < NODES.length; k++) {
          var nid = NODES[k].id;
          if (nid === a || nid === b) continue;
          if (inBox(boxes[nid], pts[j], 9)) { hits++; break; }
        }
      }
      if (hits < bestHits) { bestHits = hits; best = pts; }
      if (hits === 0) break;
    }

    var d = 'M' + best.map(function (p) { return p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' L');

    var g = el('g', { class: 'edge' });
    g.appendChild(el('title', {})).textContent = edgeSentence(edge);
    var hit = el('path', { class: 'edge-hit', d: d });
    var line = el('path', { class: 'edge-line', d: d, 'marker-end': 'url(#arw-idle)' });
    if (bi) line.setAttribute('marker-start', 'url(#arw-idle)');
    g.appendChild(hit);
    g.appendChild(line);
    svg.appendChild(g);
    edgeEls.push({ g: g, line: line, a: a, b: b, bi: bi });
  });

  paint();
}

/* ──────────────────────────────────────────────────────────────
   STATE + PAINT
   ────────────────────────────────────────────────────────────── */
var currentNode = null;
var currentLens = null;

function setEdge(e, state, mk) {
  e.g.classList.remove('dim', 'active');
  if (state === 'dim') e.g.classList.add('dim');
  if (state === 'active') {
    e.g.classList.add('active');
    e.line.style.stroke = MARKER_FILL[mk];
    e.line.setAttribute('marker-end', 'url(#arw-' + mk + ')');
    if (e.bi) e.line.setAttribute('marker-start', 'url(#arw-' + mk + ')');
  } else {
    e.line.style.stroke = '';
    e.line.setAttribute('marker-end', 'url(#arw-idle)');
    if (e.bi) e.line.setAttribute('marker-start', 'url(#arw-idle)');
  }
}

function paint() {
  var nodes = document.querySelectorAll('.node');

  if (currentNode) {
    var n = byId[currentNode];
    var touched = {};
    touched[currentNode] = true;
    edgeEls.forEach(function (e) {
      if (e.a === currentNode || e.b === currentNode) {
        touched[e.a] = true; touched[e.b] = true;
        setEdge(e, 'active', n.cat);
      } else {
        setEdge(e, 'dim');
      }
    });
    nodes.forEach(function (el2) {
      el2.classList.toggle('dim', !touched[el2.dataset.id]);
      el2.style.outline = el2.dataset.id === currentNode ? '1.5px solid ' + CATS[n.cat].color : '';
      el2.style.outlineOffset = el2.dataset.id === currentNode ? '2px' : '';
    });
    return;
  }

  if (currentLens) {
    var set = {};
    currentLens.nodes.forEach(function (id) { set[id] = true; });
    edgeEls.forEach(function (e) {
      setEdge(e, set[e.a] && set[e.b] ? 'active' : 'dim', 'lens');
    });
    nodes.forEach(function (el2) {
      var on = !!set[el2.dataset.id];
      el2.classList.toggle('dim', !on);
      el2.style.outline = on ? '1px solid ' + CATS[byId[el2.dataset.id].cat].color : '';
      el2.style.outlineOffset = on ? '2px' : '';
    });
    return;
  }

  edgeEls.forEach(function (e) { setEdge(e, 'idle'); });
  nodes.forEach(function (el2) {
    el2.classList.remove('dim');
    el2.style.outline = '';
    el2.style.outlineOffset = '';
  });
}

/* ──────────────────────────────────────────────────────────────
   INTERACTION
   ────────────────────────────────────────────────────────────── */
function chip(id) {
  var n = byId[id];
  return '<span class="chip chip-' + n.cat + '" onclick="selectNode(\'' + id + '\')">' + n.name + '</span>';
}

function selectNode(id) {
  if (currentNode === id) {
    currentNode = null;
    paint();
    if (currentLens) showLens(); else clearDetail();
    return;
  }
  currentNode = id;
  paint();

  var n = byId[id];
  var r = relations(id);
  var html = '<div class="detail-name">' + n.name + '</div>';
  html += '<div class="detail-kind">' + CATS[n.cat].label + ' · ' + n.sub + '</div>';
  html += '<div class="detail-desc">' + n.desc + '</div>';
  if (n.note) {
    html += '<ul class="detail-bullets"><li style="color:var(--amber)">' + n.note + '</li></ul>';
  }
  html += '<div class="detail-meta">';
  if (r.out.length) {
    html += '<div class="meta-row"><div class="meta-label">Informs →</div><div class="chip-list">' + r.out.map(chip).join('') + '</div></div>';
  }
  if (r.both.length) {
    html += '<div class="meta-row"><div class="meta-label">↔ Both ways</div><div class="chip-list">' + r.both.map(chip).join('') + '</div></div>';
  }
  if (r.inn.length) {
    html += '<div class="meta-row"><div class="meta-label">← Informed by</div><div class="chip-list">' + r.inn.map(chip).join('') + '</div></div>';
  }
  if (!r.out.length && !r.both.length && !r.inn.length) {
    html += '<div class="meta-row"><div class="meta-label">Relationships</div><div class="meta-value" style="font-size:12px;color:var(--text3);font-style:italic">None drawn.</div></div>';
  }
  html += '</div>';

  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = html;
}

function toggleLens(id, btn) {
  document.querySelectorAll('.pill.lens').forEach(function (b) { b.classList.remove('active'); });
  if (currentLens && currentLens.id === id) {
    currentLens = null;
    currentNode = null;
    paint();
    clearDetail();
    return;
  }
  currentLens = LENSES.filter(function (l) { return l.id === id; })[0];
  currentNode = null;
  if (btn) btn.classList.add('active');
  paint();
  showLens();
}

function showLens() {
  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = currentLens.explanation;
}

function focusOpen(i) {
  var q = OPEN[i];
  currentLens = { id: 'open-' + i, nodes: q.focus };
  currentNode = null;
  document.querySelectorAll('.pill.lens').forEach(function (b) { b.classList.remove('active'); });
  paint();
  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = '<div class="detail-name">' + q.label + '</div><div class="detail-kind">Open question</div>' +
    '<div class="detail-desc">' + q.text + '</div>' +
    '<div class="detail-meta"><div class="meta-row"><div class="meta-label">In question</div><div class="chip-list">' +
    q.focus.map(chip).join('') + '</div></div></div>';
}

function clearDetail() {
  document.getElementById('node-placeholder').style.display = 'block';
  var d = document.getElementById('node-detail');
  d.classList.remove('visible');
  d.innerHTML = '';
}

function setView(v, btn) {
  document.getElementById('main').classList.toggle('view-list', v === 'list');
  document.querySelectorAll('.pill.view').forEach(function (b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  if (v === 'map') drawEdges();
}

document.querySelector('.diagram').addEventListener('click', function (ev) {
  if (ev.target.closest('.node') || ev.target.closest('.edge')) return;
  if (currentNode) {
    currentNode = null;
    paint();
    if (currentLens) showLens(); else clearDetail();
  }
});

drawEdges();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawEdges);
</script>
</body>
</html>
