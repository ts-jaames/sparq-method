// Build reverse-link index for bidirectional highlight
const backlinks = {};
Object.keys(nodeData).forEach(function(id) {
  nodeData[id].links.forEach(function(lid) {
    if (!backlinks[lid]) backlinks[lid] = [];
    backlinks[lid].push(id);
  });
});

// ── LENSES ──
var lenses = [
  {
    id: 'christa-baseline',
    label: 'External narrative',
    highlightNodeIds: ['conf', 'ctx', 'evd', 'airigor', 'adlc', 'client', 'spot', 'stacks', 'vera'],
    explanation: '<div class="detail-name">External narrative \u2014 market-facing positioning</div><div class="detail-desc">This lens maps the current external/commercial narrative onto the system: what the story leads with when SparqOS is explained to buyers.</div><ul class="detail-bullets"><li><strong>Lit:</strong> the concepts the external narrative centers \u2014 operational confidence, context that persists (Institutional + Project Intelligence), evidence-grounded decisions, AI within guardrails, and the delivery and client-experience domains. SPOT, Stacks, and VERA light up because they\u2019re the tools behind the \u201Cno engagement starts from zero\u201D promise, even though the narrative doesn\u2019t name them directly.</li><li><strong>Dim:</strong> what the external narrative doesn\u2019t center \u2014 the economic-hypothesis discipline, \u201Cthe system we leave behind works without us,\u201D and the Sales and Resourcing domains. These are load-bearing internally but sit outside the buyer-facing story.</li><li><strong>What this surfaces:</strong> The external framing has converged toward the operating-system definition \u2014 SparqOS as an orchestration/intelligence layer, not a methodology or a product. The open question is the center of gravity. The external narrative leads with Institutional Intelligence (context compounding, no engagement starting from zero); the internal architecture has led with confidence-governed commitment (surfacing risk, earning the right to build). Not opposed \u2014 two true faces of the same system \u2014 but which one anchors the promise is a choice worth making deliberately rather than by default.</li></ul>'
  }
];

var currentLens = null;
let currentNode = null;

function allNodes() { return document.querySelectorAll('.node'); }

// Render lens buttons
(function renderLensButtons() {
  var container = document.getElementById('lens-select');
  var html = '<span class="lens-label">Lenses</span>';
  lenses.forEach(function(lens) {
    html += '<button class="lens-btn" data-lens="' + lens.id + '" onclick="toggleLens(\'' + lens.id + '\', this)">' + lens.label + '</button>';
  });
  container.innerHTML = html;
})();

function toggleLens(lensId, btn) {
  if (currentLens && currentLens.id === lensId) {
    currentLens = null;
    btn.classList.remove('active');
    resetAllNodes();
    clearNodeDetail();
    return;
  }

  currentLens = lenses.find(function(l) { return l.id === lensId; });
  currentNode = null;

  document.querySelectorAll('.lens-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');

  applyLens();
  showLensExplanation();
}

function applyLens() {
  if (!currentLens) return;
  allNodes().forEach(function(n) {
    var nid = n.dataset.id;
    n.classList.remove('click-dim', 'flow-dim');
    n.style.outline = 'none';
    n.style.outlineOffset = 'unset';

    if (currentLens.highlightNodeIds.includes(nid)) {
      var nd = nodeData[nid];
      if (nd) {
        n.style.outline = '1px solid ' + nd.typeColor;
        n.style.outlineOffset = '1px';
      }
    } else {
      n.classList.add('flow-dim');
    }
  });
  var opUnits = document.querySelector('.op-units');
  if (opUnits) opUnits.style.opacity = '0.18';
}

function showLensExplanation() {
  if (!currentLens) return;
  document.getElementById('node-placeholder').style.display = 'none';
  var detail = document.getElementById('node-detail');
  detail.classList.add('visible');
  detail.innerHTML = currentLens.explanation;
}

function resetAllNodes() {
  allNodes().forEach(function(n) {
    n.classList.remove('click-dim', 'flow-dim');
    n.style.outline = 'none';
    n.style.outlineOffset = 'unset';
  });
  var opUnits = document.querySelector('.op-units');
  if (opUnits) opUnits.style.opacity = '';
}


function selectNode(id) {
  if (currentNode === id) {
    currentNode = null;
    if (currentLens) {
      applyLens();
      showLensExplanation();
    } else {
      resetAllNodes();
      clearNodeDetail();
    }
    return;
  }
  currentNode = id;
  var d = nodeData[id];
  if (!d) return;

  var connected = {};
  d.links.forEach(function(lid) { connected[lid] = true; });
  (backlinks[id] || []).forEach(function(bid) { connected[bid] = true; });

  allNodes().forEach(function(n) {
    var nid = n.dataset.id;
    n.classList.remove('click-dim', 'flow-dim');
    n.style.outline = 'none';
    n.style.outlineOffset = 'unset';

    if (nid === id) {
      n.style.outline = '1.5px solid ' + d.typeColor;
      n.style.outlineOffset = '1px';
    } else if (currentLens && !currentLens.highlightNodeIds.includes(nid) && !connected[nid]) {
      n.classList.add('flow-dim');
    } else if (!connected[nid]) {
      n.classList.add('click-dim');
    }
  });

  renderNodeDetail(id);
}

function renderNodeDetail(id) {
  var d = nodeData[id];
  document.getElementById('node-placeholder').style.display = 'none';
  var detail = document.getElementById('node-detail');
  detail.classList.add('visible');

  var connected = [];
  d.links.forEach(function(lid) { if (!connected.includes(lid)) connected.push(lid); });
  (backlinks[id] || []).forEach(function(bid) { if (!connected.includes(bid)) connected.push(bid); });

  function makeChip(nid) {
    var nd = nodeData[nid];
    if (!nd) return '';
    return '<span class="node-chip node-chip-' + nd.type + '" onclick="selectNode(\'' + nid + '\')">' + nd.name + '</span>';
  }

  var html = '<div class="detail-name">' + d.name + '</div>';
  html += '<div class="detail-desc">' + d.desc + '</div>';

  if (d.nonNegotiables && d.nonNegotiables.length > 0) {
    html += '<ul class="detail-bullets">';
    d.nonNegotiables.forEach(function(nn) {
      html += '<li>' + nn + '</li>';
    });
    html += '</ul>';
  }

  html += '<div class="detail-meta">';

  if (connected.length > 0) {
    html += '<div class="meta-row"><div class="meta-label">Connected</div><div class="chip-list">';
    connected.forEach(function(cid) {
      html += makeChip(cid);
    });
    html += '</div></div>';
  }

  d.details.forEach(function(item) {
    html += '<div class="meta-row"><div class="meta-label">' + item.label + '</div><div class="meta-value">' + item.value + '</div></div>';
  });

  if (d.type === 'undefined') {
    html += '<div class="undef-note">Not part of the system until it connects to a principle.</div>';
  }

  html += '</div>';
  detail.innerHTML = html;
}

function clearNodeDetail() {
  document.getElementById('node-placeholder').style.display = 'block';
  var detail = document.getElementById('node-detail');
  detail.classList.remove('visible');
  detail.innerHTML = '';
}
</script>
