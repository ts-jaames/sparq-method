/* ──────────────────────────────────────────────────────────────
   EDGE DRAWING
   Quadratic curves, auto-routed: each edge tries increasing
   curvature until its path clears every node box it does not
   belong to.
   ────────────────────────────────────────────────────────────── */
var SVGNS = 'http://www.w3.org/2000/svg';
var MARKER_FILL = {
  idle: 'rgba(229,229,229,0.42)',
  hover: '#E5E5E5',
  found: CATS.found.color,
  delivery: CATS.delivery.color,
  store: CATS.store.color,
  surface: CATS.surface.color,
  gtm: CATS.gtm.color,
  external: CATS.external.color,
  lens: '#E5E5E5'
};
var BOWS = [0, 55, -55, 100, -100, 150, -150, 210, -210, 280, -280, 360, -360];
var SAMPLES = 72;
var edgeEls = [];

function el(tag, attrs) {
  var n = document.createElementNS(SVGNS, tag);
  Object.keys(attrs || {}).forEach(function (k) { n.setAttribute(k, attrs[k]); });
  return n;
}

function boxOf(id) {
  var n = byId[id];
  var resolvedId = (n && n.embedded) ? n.embedded : id;
  var e = document.getElementById('n-' + resolvedId);
  if (!e) return { x: 0, y: 0, w: 0, h: 0 };
  return { x: e.offsetLeft, y: e.offsetTop, w: e.offsetWidth, h: e.offsetHeight };
}

function inBox(b, p, pad) {
  return p.x > b.x - pad && p.x < b.x + b.w + pad && p.y > b.y - pad && p.y < b.y + b.h + pad;
}

function curvePoints(p1, p2, bow) {
  var dx = p2.x - p1.x, dy = p2.y - p1.y;
  var len = Math.sqrt(dx * dx + dy * dy) || 1;
  var c = { x: (p1.x + p2.x) / 2 + (-dy / len) * bow, y: (p1.y + p2.y) / 2 + (dx / len) * bow };
  var pts = [];
  for (var i = 0; i <= SAMPLES; i++) {
    var t = i / SAMPLES, u = 1 - t;
    pts.push({
      x: u * u * p1.x + 2 * u * t * c.x + t * t * p2.x,
      y: u * u * p1.y + 2 * u * t * c.y + t * t * p2.y
    });
  }
  return pts;
}

function trim(pts, ba, bb) {
  var s = 0, e = pts.length - 1;
  while (s < pts.length && inBox(ba, pts[s], 5)) s++;
  while (e > 0 && inBox(bb, pts[e], 5)) e--;
  if (s >= e) { s = 0; e = pts.length - 1; }
  return pts.slice(s, e + 1);
}

function pulseOf(a, b, bi) {
  if (bi) return PULSES[a + '<>' + b] || PULSES[b + '<>' + a] || null;
  return PULSES[a + '>' + b] || null;
}

function pairKey(a, b) {
  return a < b ? a + '|' + b : b + '|' + a;
}

function addPulseDot(g, pathId, speed, reverse, delay) {
  var c = el('circle', {
    class: 'pulse-dot pulse-' + speed,
    r: '1.4',
    fill: 'rgba(229,229,229,0.8)'
  });
  var motion = el('animateMotion', {
    dur: speed === 'slow' ? '5s' : '1.2s',
    repeatCount: 'indefinite',
    begin: delay + 's'
  });
  if (reverse) {
    motion.setAttribute('keyPoints', '1;0');
    motion.setAttribute('keyTimes', '0;1');
    motion.setAttribute('calcMode', 'linear');
  }
  var mp = el('mpath', {});
  mp.setAttribute('href', '#' + pathId);
  mp.setAttributeNS('http://www.w3.org/1999/xlink', 'href', '#' + pathId);
  motion.appendChild(mp);
  c.appendChild(motion);
  g.appendChild(c);
}

function drawEdges() {
  var svg = document.getElementById('edges');
  svg.innerHTML = '';
  edgeEls = [];

  var defs = el('defs', {});
  Object.keys(MARKER_FILL).forEach(function (k) {
    var m = el('marker', {
      id: 'arw-' + k, viewBox: '0 0 10 10', refX: '8.5', refY: '5',
      markerWidth: '7.5', markerHeight: '7.5', orient: 'auto-start-reverse'
    });
    m.appendChild(el('path', { d: 'M0,1.2 L8.5,5 L0,8.8 z', fill: MARKER_FILL[k] }));
    defs.appendChild(m);
  });
  svg.appendChild(defs);

  var boxes = {};
  NODES.forEach(function (n) { boxes[n.id] = boxOf(n.id); });
  var pairBows = {};

  EDGES.forEach(function (edge, idx) {
    var a = edge[0], b = edge[1], bi = edge[2] === '<>';
    if ((byId[a] && byId[a].embedded) || (byId[b] && byId[b].embedded)) return;
    var ba = boxes[a], bb = boxes[b];
    var p1 = { x: ba.x + ba.w / 2, y: ba.y + ba.h / 2 };
    var p2 = { x: bb.x + bb.w / 2, y: bb.y + bb.h / 2 };
    var usedBows = pairBows[pairKey(a, b)] || [];
    var search = BOWS;
    if (usedBows.length) {
      var prev = usedBows[0];
      var preferred = BOWS.filter(function (bow) {
        if (usedBows.indexOf(bow) !== -1) return false;
        if (prev === 0) return Math.abs(bow) >= 210;
        return bow * prev < 0 && Math.abs(bow) >= 150;
      });
      var rest = BOWS.filter(function (bow) { return usedBows.indexOf(bow) === -1 && preferred.indexOf(bow) === -1; });
      search = preferred.concat(rest);
    }

    var best = null, bestHits = Infinity, bestBow = null;
    for (var i = 0; i < search.length; i++) {
      var pts = trim(curvePoints(p1, p2, search[i]), ba, bb);
      var hits = 0;
      for (var j = 0; j < pts.length; j++) {
        for (var k = 0; k < NODES.length; k++) {
          var nid = NODES[k].id;
          if (nid === a || nid === b) continue;
          if (inBox(boxes[nid], pts[j], 9)) { hits++; break; }
        }
      }
      if (hits < bestHits) { bestHits = hits; best = pts; bestBow = search[i]; }
      if (hits === 0) break;
    }
    pairBows[pairKey(a, b)] = usedBows.concat([bestBow]);

    var pathId = 'elp-' + idx;
    var d = 'M' + best.map(function (p) { return p.x.toFixed(1) + ' ' + p.y.toFixed(1); }).join(' L');

    var g = el('g', { class: bi ? 'edge bi' : 'edge' });
    g.appendChild(el('title', {})).textContent = edgeSentence(edge);
    var hit = el('path', { class: 'edge-hit', d: d });
    var line = el('path', { class: 'edge-line', id: pathId, d: d, 'marker-end': 'url(#arw-idle)' });
    if (bi) line.setAttribute('marker-start', 'url(#arw-idle)');
    g.appendChild(hit);
    g.appendChild(line);

    var speed = pulseOf(a, b, bi);
    if (speed) {
      var pulses = el('g', { class: 'edge-pulses' });
      var count = speed === 'slow' ? (bi ? 1 : 2) : (bi ? 2 : 3);
      var gap = speed === 'slow' ? 2.5 : 0.4;
      for (var p = 0; p < count; p++) addPulseDot(pulses, pathId, speed, false, p * gap);
      if (bi) {
        for (var r = 0; r < count; r++) addPulseDot(pulses, pathId, speed, true, r * gap + gap / 2);
      }
      g.appendChild(pulses);
    }

    svg.appendChild(g);
    edgeEls.push({ g: g, line: line, a: a, b: b, bi: bi, pts: best });
  });

  placeAgents();
  paint();
}

function placeAgents() {
  var canvas = document.getElementById('canvas');
  canvas.querySelectorAll('.agent').forEach(function (x) { x.remove(); });
  AGENTS.forEach(function (ag) {
    var e = null;
    for (var i = 0; i < edgeEls.length; i++) {
      var ed = edgeEls[i];
      var match = ag.directed
        ? (ed.a === ag.a && ed.b === ag.b)
        : ((ed.a === ag.a && ed.b === ag.b) || (ed.a === ag.b && ed.b === ag.a));
      if (match) { e = ed; break; }
    }
    if (!e || !e.pts || !e.pts.length) return;
    var mid = e.pts[Math.floor(e.pts.length / 2)];
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'agent agent-' + ag.cat + (mid.x > 760 ? ' flip' : '');
    btn.id = 'agent-' + ag.id;
    btn.style.left = mid.x + 'px';
    btn.style.top = mid.y + 'px';
    btn.setAttribute('aria-label', ag.name);
    btn.innerHTML = SPARK_SVG +
      '<span class="agent-tip"><span class="agent-tip-name">' + ag.name + '</span>' +
      '<span class="agent-tip-copy">' + ag.copy + '</span></span>';
    btn.addEventListener('click', function (ev) {
      ev.stopPropagation();
      selectAgent(ag.id);
    });
    canvas.appendChild(btn);
  });
}

/* ──────────────────────────────────────────────────────────────
   STATE + PAINT
   ────────────────────────────────────────────────────────────── */
var currentNode = null;
var currentLens = null;
var currentAgent = null;
var drilled = false;

function agentOnEdge(ag, e) {
  if (ag.directed) return e.a === ag.a && e.b === ag.b;
  return (e.a === ag.a && e.b === ag.b) || (e.a === ag.b && e.b === ag.a);
}

function paintAgents() {
  var agents = document.querySelectorAll('.agent');
  if (currentAgent) {
    agents.forEach(function (el2) {
      el2.classList.toggle('selected', el2.id === 'agent-' + currentAgent);
      el2.classList.toggle('dim', el2.id !== 'agent-' + currentAgent);
    });
    return;
  }
  if (currentNode) {
    agents.forEach(function (el2) {
      var ag = byAgent[el2.id.replace('agent-', '')];
      var on = ag && (ag.a === currentNode || ag.b === currentNode);
      el2.classList.toggle('dim', !on);
      el2.classList.remove('selected');
    });
    return;
  }
  if (currentLens) {
    var set = {};
    currentLens.nodes.forEach(function (id) { set[id] = true; });
    agents.forEach(function (el2) {
      var ag = byAgent[el2.id.replace('agent-', '')];
      el2.classList.toggle('dim', !(ag && set[ag.a] && set[ag.b]));
      el2.classList.remove('selected');
    });
    return;
  }
  agents.forEach(function (el2) { el2.classList.remove('dim', 'selected'); });
}

function setEdge(e, state, mk) {
  e.g.classList.remove('dim', 'active');
  if (state === 'dim') e.g.classList.add('dim');
  var pulseFill = 'rgba(229,229,229,0.8)';
  if (state === 'active') {
    e.g.classList.add('active');
    e.line.style.stroke = MARKER_FILL[mk];
    e.line.setAttribute('marker-end', 'url(#arw-' + mk + ')');
    if (e.bi) e.line.setAttribute('marker-start', 'url(#arw-' + mk + ')');
    pulseFill = MARKER_FILL[mk];
  } else {
    e.line.style.stroke = '';
    e.line.setAttribute('marker-end', 'url(#arw-idle)');
    if (e.bi) e.line.setAttribute('marker-start', 'url(#arw-idle)');
  }
  e.g.querySelectorAll('.pulse-dot').forEach(function (p) { p.setAttribute('fill', pulseFill); });
}

function paint() {
  var nodes = document.querySelectorAll('.node');

  if (currentAgent) {
    var ag = byAgent[currentAgent];
    edgeEls.forEach(function (e) {
      setEdge(e, agentOnEdge(ag, e) ? 'active' : 'dim', ag.cat);
    });
    nodes.forEach(function (el2) {
      var on = el2.dataset.id === ag.a || el2.dataset.id === ag.b;
      el2.classList.toggle('dim', !on);
      el2.classList.remove('selected');
      el2.style.outline = on ? '1px solid ' + CATS[byId[el2.dataset.id].cat].color : '';
      el2.style.outlineOffset = on ? '2px' : '';
    });
    paintAgents();
    return;
  }

  if (currentNode) {
    var n = byId[currentNode];
    var parentId = n.embedded || null;
    var touched = {};
    touched[currentNode] = true;
    if (parentId) touched[parentId] = true;
    edgeEls.forEach(function (e) {
      if (e.a === currentNode || e.b === currentNode) {
        touched[e.a] = true; touched[e.b] = true;
        setEdge(e, 'active', n.cat);
      } else {
        setEdge(e, 'dim');
      }
    });
    nodes.forEach(function (el2) {
      var did = el2.dataset.id;
      el2.classList.toggle('dim', !touched[did]);
      el2.classList.toggle('selected', did === currentNode || did === parentId);
      el2.style.outline = (did === currentNode || did === parentId) ? '1.5px solid ' + CATS[n.cat].color : '';
      el2.style.outlineOffset = (did === currentNode || did === parentId) ? '2px' : '';
    });
    paintAgents();
    return;
  }

  if (currentLens) {
    var set = {};
    currentLens.nodes.forEach(function (id) { set[id] = true; });
    edgeEls.forEach(function (e) {
      setEdge(e, set[e.a] && set[e.b] ? 'active' : 'dim', 'lens');
    });
    nodes.forEach(function (el2) {
      var on = !!set[el2.dataset.id];
      el2.classList.toggle('dim', !on);
      el2.classList.remove('selected');
      el2.style.outline = on ? '1px solid ' + CATS[byId[el2.dataset.id].cat].color : '';
      el2.style.outlineOffset = on ? '2px' : '';
    });
    paintAgents();
    return;
  }

  edgeEls.forEach(function (e) { setEdge(e, 'idle'); });
  nodes.forEach(function (el2) {
    el2.classList.remove('dim', 'selected');
    el2.style.outline = '';
    el2.style.outlineOffset = '';
  });
  paintAgents();
}

/* ──────────────────────────────────────────────────────────────
   INTERACTION
   ────────────────────────────────────────────────────────────── */
function chip(rel) {
  var n = byId[rel.id];
  var title = rel.verb && rel.verb !== 'informs' ? ' title="' + rel.verb + '"' : '';
  return '<span class="chip chip-' + n.cat + '"' + title + ' onclick="selectNode(\'' + rel.id + '\')">' + n.name + '</span>';
}

function onDrillBtn(ev, id) {
  ev.stopPropagation();
  if (currentNode === id) {
    if (drilled) undrill();
    else drillNode();
    return;
  }
  selectNode(id);
}

function clearDrilled() {
  document.querySelectorAll('.node.drilled').forEach(function (x) {
    x.classList.remove('drilled');
    var btn = x.querySelector('.drill-btn');
    if (btn) btn.setAttribute('aria-label', 'Dig deeper');
  });
}

/* Click once to isolate, again to drill one altitude down, again to clear. */
function selectNode(id) {
  currentAgent = null;
  if (currentNode === id) {
    if (!drilled) { drillNode(); return; }
    currentNode = null;
    drilled = false;
    paint();
    if (currentLens) showLens(); else clearDetail();
    return;
  }
  currentNode = id;
  drilled = false;
  paint();
  renderSelection();
}

function selectAgent(id) {
  if (currentAgent === id) {
    currentAgent = null;
    paint();
    if (currentLens) showLens(); else clearDetail();
    return;
  }
  currentAgent = id;
  currentNode = null;
  drilled = false;
  clearDrilled();
  paint();
  var ag = byAgent[id];
  var html = '<div class="detail-name">' + ag.name + '</div>';
  html += '<div class="detail-kind">Agent on a flow</div>';
  html += '<div class="detail-desc">' + ag.copy + '</div>';
  html += '<div class="detail-meta"><div class="meta-row"><div class="meta-label">Governs</div><div class="chip-list">' +
    chip({ id: ag.a }) + chip({ id: ag.b }) + '</div></div></div>';
  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = html;
  setSidebarNodeSelected(true);
}

function renderSelection() {
  var n = byId[currentNode];
  var r = relations(currentNode);
  var html = '<div class="detail-name">' + n.name + '</div>';
  html += '<div class="detail-kind">' + CATS[n.cat].label + ' · ' + n.sub + (n.tag ? ' · ' + n.tag.toLowerCase() : n.provisional ? ' · working name' : '') + '</div>';
  html += '<div class="detail-desc">' + n.desc + '</div>';
  if (n.resolved && n.resolved.length) {
    html += '<div class="meta-label" style="margin-bottom:8px">Resolved</div>';
    html += '<ul class="detail-bullets">';
    n.resolved.forEach(function (item) {
      html += '<li>' + item + '</li>';
    });
    html += '</ul>';
  }
  if (n.note) {
    html += '<div class="meta-label" style="margin-bottom:8px">Still open</div>';
    html += '<ul class="detail-bullets"><li style="color:var(--amber)">' + n.note + '</li></ul>';
  }
  html += '<div class="detail-meta">';
  if (r.out.length) {
    html += '<div class="meta-row"><div class="meta-label">Informs →</div><div class="chip-list">' + r.out.map(chip).join('') + '</div></div>';
  }
  if (r.both.length) {
    html += '<div class="meta-row"><div class="meta-label">↔ Both ways</div><div class="chip-list">' + r.both.map(chip).join('') + '</div></div>';
  }
  if (r.inn.length) {
    html += '<div class="meta-row"><div class="meta-label">← Informed by</div><div class="chip-list">' + r.inn.map(chip).join('') + '</div></div>';
  }
  if (!r.out.length && !r.both.length && !r.inn.length) {
    html += '<div class="meta-row"><div class="meta-label">Relationships</div><div class="meta-value" style="font-size:12px;color:var(--text3);font-style:italic">None drawn.</div></div>';
  }
  html += '<div class="meta-row"><div class="meta-label">Interior</div><div class="meta-value">' +
    (n.depth === 'defined'
      ? 'Defined — <a href="#" onclick="drillNode();return false" style="color:' + CATS[n.cat].color + '">Dig deeper</a> (or the shovel on the node)'
      : 'Not defined yet — <a href="#" onclick="drillNode();return false" style="color:var(--text3)">why</a>') +
    '</div></div>';
  html += '</div>';

  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = html;
  setSidebarNodeSelected(true);
}

/* One altitude down. Nodes without a defined interior say so; they
   never get a fabricated one. */
function drillNode() {
  if (!currentNode) return;
  drilled = true;
  var n = byId[currentNode];
  var el2 = document.getElementById('n-' + currentNode);
  clearDrilled();
  if (el2) el2.classList.add('drilled');
  var btn = el2 && el2.querySelector('.drill-btn');
  if (btn) btn.setAttribute('aria-label', 'Close');

  var html = '<button class="drill-back" onclick="undrill()">← ' + n.name + '</button>';
  html += '<div class="detail-name">Inside ' + n.name + '</div>';

  if (n.depth === 'defined') {
    html += '<div class="detail-kind">One altitude down · defined</div>';
    html += '<div class="detail-desc">' + n.interior.summary + '</div>';
    n.interior.groups.forEach(function (g) {
      html += '<div class="drill-group"><div class="drill-group-label">' + g.label + '</div>';
      g.items.forEach(function (it) { html += '<div class="drill-item">' + it + '</div>'; });
      if (g.source) {
        html += '<span class="drill-source">Defined in <a href="' + g.source.href + '">' + g.source.label + '</a></span>';
      }
      html += '</div>';
    });
  } else {
    html += '<div class="detail-kind">One altitude down · not defined</div>';
    html += '<div class="drill-none"><div class="drill-none-label">No detail defined</div>' +
      '<div class="drill-none-text">' + n.needs + '</div></div>';
    html += '<span class="drill-source">A node\'s depth is a confidence claim. This one has none to make yet, so nothing is shown rather than something invented.</span>';
  }

  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = html;
  setSidebarNodeSelected(true);
}

function undrill() {
  drilled = false;
  clearDrilled();
  if (currentNode) renderSelection(); else clearDetail();
}

function toggleLens(id, btn) {
  document.querySelectorAll('.pill.lens').forEach(function (b) { b.classList.remove('active'); });
  if (currentLens && currentLens.id === id) {
    currentLens = null;
    currentNode = null;
    currentAgent = null;
    drilled = false;
    clearDrilled();
    paint();
    clearDetail();
    return;
  }
  currentLens = LENSES.filter(function (l) { return l.id === id; })[0];
  currentNode = null;
  currentAgent = null;
  drilled = false;
  clearDrilled();
  if (btn) btn.classList.add('active');
  paint();
  showLens();
}

function showLens() {
  setSidebarNodeSelected(false);
  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = currentLens.explanation;
}

function focusOpen(i) {
  var q = OPEN[i];
  currentLens = { id: 'open-' + i, nodes: q.focus };
  currentNode = null;
  currentAgent = null;
  drilled = false;
  clearDrilled();
  document.querySelectorAll('.pill.lens').forEach(function (b) { b.classList.remove('active'); });
  paint();
  setSidebarNodeSelected(false);
  document.getElementById('node-placeholder').style.display = 'none';
  var d = document.getElementById('node-detail');
  d.classList.add('visible');
  d.innerHTML = '<div class="detail-name">' + q.label + '</div><div class="detail-kind">Open question</div>' +
    '<div class="detail-desc">' + q.text + '</div>' +
    '<div class="detail-meta"><div class="meta-row"><div class="meta-label">In question</div><div class="chip-list">' +
    q.focus.map(function (fid) { return chip({ id: fid }); }).join('') + '</div></div></div>';
}

function setSidebarNodeSelected(on) {
  document.querySelector('.sidebar').classList.toggle('node-selected', on);
}

function clearDetail() {
  drilled = false;
  clearDrilled();
  setSidebarNodeSelected(false);
  document.getElementById('node-placeholder').style.display = 'block';
  var d = document.getElementById('node-detail');
  d.classList.remove('visible');
  d.innerHTML = '';
}

function setView(v, btn) {
  document.getElementById('main').classList.toggle('view-list', v === 'list');
  document.querySelectorAll('.pill.view').forEach(function (b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  if (v === 'map') drawEdges();
}

document.querySelector('.diagram').addEventListener('click', function (ev) {
  if (ev.target.closest('.node') || ev.target.closest('.edge') || ev.target.closest('.agent')) return;
  if (currentNode || currentAgent) {
    currentNode = null;
    currentAgent = null;
    drilled = false;
    clearDrilled();
    paint();
    if (currentLens) showLens(); else clearDetail();
  }
});

drawEdges();
if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawEdges);
</script>
</body>
</html>
