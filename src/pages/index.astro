---
import { ViewTransitions } from 'astro:transitions';

// ── SparqOS home state ──────────────────────────────────────────────────────
// Single source of truth for everything the home page renders. Hardcoded for
// now; every field here is meant to be driven by a canonical source later (see
// `sources` below), so wiring real data is a matter of replacing this object,
// not touching markup.
const os = {
  wordmark: "SparqOS",
  edition: "Internal operating system · v0.1 · Edition 2026.1",
  // The "what it is" statement — a plain sentence, not a section header.
  statement:
    "The operating system Sparq's principles produced — the methods and tools those principles built, and how they fit together.",

  // Primary entry cards — the real navigation into each major area.
  cards: [
    {
      title: "Ecosystem",
      desc: "The map of what exists and how it relates.",
      meta: "Full OS map",
      href: "/architecture/",
    },
    {
      title: "Client narrative",
      desc: "The story of what it's like to work with Sparq.",
      meta: "Read-aloud →",
      href: "/SparqStory/",
    },
    {
      title: "Roles & capabilities",
      desc: "Who does what, and which capabilities exist today.",
      meta: "Forming",
      href: "#",
    },
    {
      title: "Principles",
      desc: "The non-negotiables the whole system derives from.",
      meta: "6 principles",
      href: "/philosophy/",
    },
  ],

  // Current state — glanceable counts. Placeholders until source-driven.
  glance: [
    { value: "6", label: "Principles" },
    { value: "5", label: "Domains" },
    { value: "2", label: "Work loops" },
    { value: "3", label: "Maturity levels" },
  ],

  // What's defined vs. still forming across the system.
  status: [
    { name: "Engagement system", state: "defined" },
    { name: "Work loops", state: "defined" },
    { name: "AI enablement & governance", state: "forming" },
    { name: "Roles & capabilities", state: "forming" },
    { name: "Capability maturity", state: "forming" },
  ],

  // Forward state: canonical inputs SparqOS will generate from. Not yet live.
  sources: [
    { name: "Principles doc", type: "Canonical", status: "Not connected" },
    { name: "Engagement playbook", type: "Canonical", status: "Not connected" },
    { name: "Roles & capability matrix", type: "Spreadsheet", status: "Not connected" },
    { name: "Tooling registry", type: "System", status: "Not connected" },
  ],
};

const stateLabels = { defined: "Defined", forming: "Forming" };
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SparqOS</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <ViewTransitions />
</head>
<body>
<div class="os">

    <header class="os-masthead">
        <div class="os-wordmark">{os.wordmark}</div>
        <div class="os-edition">{os.edition}</div>
    </header>

    <div class="os-premise">
        <p>{os.statement}</p>
    </div>

    <div class="os-hero">
        <canvas id="heroCanvas" aria-hidden="true"></canvas>
    </div>

    <!-- Primary entry cards — the real navigation into each major area. -->
    <section class="os-section">
        <div class="os-section-label">Ways in</div>
        <div class="os-cards">
            {os.cards.map((c) => (
                <a href={c.href} class="os-card">
                    <span class="os-card-title">{c.title}</span>
                    <span class="os-card-desc">{c.desc}</span>
                    <span class="os-card-meta">{c.meta}</span>
                </a>
            ))}
        </div>
    </section>

    <!-- Current state — the dashboard: glanceable counts + what's defined vs. forming. -->
    <section class="os-section">
        <div class="os-section-label">Current state · at a glance</div>
        <div class="os-glance">
            {os.glance.map((s) => (
                <div class="os-stat">
                    <span class="os-stat-value">{s.value}</span>
                    <span class="os-stat-label">{s.label}</span>
                </div>
            ))}
        </div>
        <div class="os-status">
            {os.status.map((s) => (
                <div class="os-status-row">
                    <span class={`os-status-dot os-status-dot--${s.state}`}></span>
                    <span class="os-status-name">{s.name}</span>
                    <span class="os-status-state">{stateLabels[s.state]}</span>
                </div>
            ))}
        </div>
    </section>

    <!-- Sources — forward state, scaffolded only. -->
    <section class="os-section">
        <div class="os-section-label">Sources</div>
        <p class="os-section-sub">Forward state — not yet live. SparqOS will generate from these canonical inputs; when a source changes, the site reflects it.</p>
        <div class="os-sources">
            {os.sources.map((s) => (
                <div class="os-source-row">
                    <span class="os-source-name">{s.name}</span>
                    <span class="os-source-type">{s.type}</span>
                    <span class="os-source-status">{s.status}</span>
                </div>
            ))}
        </div>
    </section>

    <div class="os-closing">
        <canvas id="closingCanvas" aria-hidden="true"></canvas>
    </div>

    <footer class="os-colophon">
        v1.0 · Edition 2026.1 · Last updated May 2026 · Internal use only
    </footer>

</div>

<script is:inline>
var __dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;

function initHero() {
    var el = document.getElementById('heroCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var SIZE = el.offsetWidth;
    if (SIZE < 10) return;

    var dpr = window.devicePixelRatio || 1;
    el.width = SIZE * dpr;
    el.height = SIZE * dpr;

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // ── The "connecting" thinking-orb, ported from thinking-orbs (engine/web.ts):
    // a constellation of nodes on a slowly-spinning sphere wires itself — nodes
    // drift under value-noise, any pair closer than `thr` grows an edge, and
    // bright packets ("signals") run along re-picked node pairs. Genuinely 3D:
    // rotated, depth-shaded, z-sorted. Tinted to brand orange. ──
    var COLOR = '#E75437';         // nodes + edges
    var SIGNAL_COLOR = '#F4845F';  // the bright travelling packets
    var cx = SIZE / 2;
    var cy = SIZE / 2;

    // Orb config (defaults from the library, nodeN/signals nudged up for a
    // fuller constellation at hero scale).
    var nodeN = 80;         // more dots than the library default (30) for a fuller orb
    var thr = 0.68;         // edge threshold, unit-sphere distance
    var nodeR = 2, nodeRDepth = 2.8;
    var signals = 8;
    var lineW = 0.5;
    var SPEED = 1.8;        // demo's web-preset speed multiplier (base runs at 1×)
    var spread = 1;
    var ORB_R = (SIZE / 2) * 0.8 * spread;   // projector scale (carries the radius)
    var rs = Math.pow(SIZE / 300, 0.3);      // sub-linear radius scale

    // ── Shared primitives (core.ts) ──
    function frac(x) { return x - Math.floor(x); }
    function lerp(a, b, f) { return a + (b - a) * f; }
    function hashD(a, b) {
        var h = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453;
        return h - Math.floor(h);
    }
    function vnoise(x, y) {
        var xi = Math.floor(x), yi = Math.floor(y);
        var fx = x - xi, fy = y - yi;
        fx = fx * fx * (3 - 2 * fx);
        fy = fy * fy * (3 - 2 * fy);
        var a = hashD(xi, yi), b = hashD(xi + 1, yi), c = hashD(xi, yi + 1), d = hashD(xi + 1, yi + 1);
        return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
    }
    var GOLDEN = Math.PI * (3 - Math.sqrt(5));
    function fibDir(i, n) {
        var y = 1 - (2 * (i + 0.5)) / n;
        var rad = Math.sqrt(1 - y * y);
        var a = i * GOLDEN;
        return [rad * Math.cos(a), y, rad * Math.sin(a)];
    }
    // Spin (yaw) + tilt + orthographic projection. Returns [screenX, screenY, z].
    function makeProj(yaw, tilt) {
        var st = Math.sin(tilt), ct = Math.cos(tilt), sy = Math.sin(yaw), cyw = Math.cos(yaw);
        return function (x, y, z) {
            var x1 = x * cyw + z * sy;
            var z1 = -x * sy + z * cyw;
            var y1 = y * ct - z1 * st;
            var z2 = y * st + z1 * ct;
            return [cx + x1 * ORB_R, cy - y1 * ORB_R, z2];
        };
    }

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var startT = performance.now();

    function frame(t) {
        ctx.clearRect(0, 0, SIZE, SIZE);
        var pt = makeProj(t * 0.12, 0.32);

        // Nodes: fibonacci lattice + slow noise wander, renormalised to the surface.
        var nodes = [];
        for (var i = 0; i < nodeN; i++) {
            var dir = fibDir(i, nodeN);
            var nx = dir[0] + 0.3 * (vnoise(i * 0.31 + 9, t * 0.24) - 0.5) * 2;
            var ny = dir[1] + 0.3 * (vnoise(i * 0.53 + 27, t * 0.21) - 0.5) * 2;
            var nz = dir[2] + 0.3 * (vnoise(i * 0.77 + 55, t * 0.27) - 0.5) * 2;
            var nl = Math.sqrt(nx * nx + ny * ny + nz * nz);
            nodes.push([nx / nl, ny / nl, nz / nl]);
        }

        // Edges between close neighbours, drawn first so nodes sit on top.
        ctx.lineWidth = Math.max(0.6, lineW * rs);
        for (var i2 = 0; i2 < nodeN; i2++) {
            for (var j2 = i2 + 1; j2 < nodeN; j2++) {
                var dx = nodes[i2][0] - nodes[j2][0];
                var dy = nodes[i2][1] - nodes[j2][1];
                var dz = nodes[i2][2] - nodes[j2][2];
                var dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
                if (dist >= thr) continue;
                var pa = pt(nodes[i2][0], nodes[i2][1], nodes[i2][2]);
                var pb = pt(nodes[j2][0], nodes[j2][1], nodes[j2][2]);
                var edepth = ((pa[2] + pb[2]) / 2 + 1) / 2;
                ctx.globalAlpha = (1 - dist / thr) * (0.3 + 0.55 * edepth);
                ctx.strokeStyle = COLOR;
                ctx.beginPath();
                ctx.moveTo(pa[0], pa[1]);
                ctx.lineTo(pb[0], pb[1]);
                ctx.stroke();
            }
        }

        // Collect node + signal dots, then z-sort far→near so depth reads right.
        var dots = [];
        for (var i3 = 0; i3 < nodeN; i3++) {
            var pn = pt(nodes[i3][0], nodes[i3][1], nodes[i3][2]);
            var depth = (pn[2] + 1) / 2;
            var pulse = 1 + 0.25 * Math.sin(t * 1.4 + i3 * 2.7);
            dots.push({
                x: pn[0], y: pn[1], z: pn[2],
                r: (nodeR + nodeRDepth * depth) * pulse * rs,
                color: COLOR,
                a: 0.25 + 0.75 * depth,   // near = brighter
            });
        }
        // Signals: bright packets running between paired nodes.
        for (var s = 0; s < signals; s++) {
            var seg = Math.floor(t * 0.55 + s * 7.31);
            var ai = Math.floor(hashD(seg, s * 3.1 + 1.7) * nodeN);
            var bi = Math.floor(hashD(seg, s * 5.7 + 4.2) * nodeN);
            if (ai === bi) continue;
            var f = frac(t * 0.55 + s * 7.31);
            var sx = lerp(nodes[ai][0], nodes[bi][0], f);
            var sy2 = lerp(nodes[ai][1], nodes[bi][1], f);
            var sz = lerp(nodes[ai][2], nodes[bi][2], f);
            var sl = Math.max(1e-6, Math.sqrt(sx * sx + sy2 * sy2 + sz * sz));
            var ps = pt(sx / sl, sy2 / sl, sz / sl);
            var sdepth = (ps[2] + 1) / 2;
            dots.push({
                x: ps[0], y: ps[1], z: ps[2],
                r: (nodeR * 1.5 + nodeRDepth * sdepth) * rs,
                color: SIGNAL_COLOR,
                a: 0.5 + 0.5 * sdepth,
            });
        }

        dots.sort(function (p, q) { return p.z - q.z; });
        for (var k = 0; k < dots.length; k++) {
            var dd = dots[k];
            if (dd.a < 0.02) continue;
            ctx.globalAlpha = dd.a;
            ctx.fillStyle = dd.color;
            ctx.beginPath();
            ctx.arc(dd.x, dd.y, Math.max(0.3, dd.r), 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
    }

    function tick() {
        if (!document.body.contains(el)) return;
        frame((performance.now() - startT) / 1000 * SPEED);
        requestAnimationFrame(tick);
    }

    if (reduced) {
        frame(1.2);  // one settled pose, no animation
    } else {
        requestAnimationFrame(tick);
    }
}

function initNucleus() {
    var el = document.getElementById('nucleusCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var SIZE = 120;
    var COUNT = 560;
    var COLOR = '#E75437';

    var dpr = window.devicePixelRatio || 1;
    el.width = SIZE * dpr;
    el.height = SIZE * dpr;
    el.style.width = SIZE + 'px';
    el.style.height = SIZE + 'px';

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    var cx = SIZE / 2;
    var cy = SIZE / 2;
    var radius = SIZE / 2 - 2;

    var particles = [];
    for (var i = 0; i < COUNT; i++) {
        var x, y;
        do { x = (Math.random() - 0.5) * 2; y = (Math.random() - 0.5) * 2; }
        while (x * x + y * y > 1);
        var speed = 0.001 + Math.random() * 0.002;
        var angle = Math.random() * Math.PI * 2;
        particles.push({
            x: x, y: y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            r: 0.5 + Math.random() * 1.6,
            opacity: 0.2 + Math.random() * 0.6,
        });
    }

    var LINK_DIST = 0.35;
    var linkNodes = [];
    for (var li = 0; li < 100; li++) {
        linkNodes.push(particles[Math.floor(Math.random() * COUNT)]);
    }

    function tick() {
        if (!document.body.contains(el)) return;
        ctx.clearRect(0, 0, SIZE, SIZE);

        for (var j = 0; j < particles.length; j++) {
            var p = particles[j];
            p.x += (Math.random() - 0.5) * 0.003;
            p.y += (Math.random() - 0.5) * 0.003;
            p.x += p.vx;
            p.y += p.vy;
            var spd = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
            var MAX_SPD = 0.003;
            if (spd > MAX_SPD) { p.vx *= MAX_SPD / spd; p.vy *= MAX_SPD / spd; }
            p.x *= 0.9997;
            p.y *= 0.9997;
            var dist = Math.sqrt(p.x * p.x + p.y * p.y);
            if (dist > 0.95) {
                var nx = p.x / dist, ny = p.y / dist;
                var dot = p.vx * nx + p.vy * ny;
                p.vx -= 2 * dot * nx;
                p.vy -= 2 * dot * ny;
                p.x *= 0.94 / dist;
                p.y *= 0.94 / dist;
            }
        }

        ctx.strokeStyle = '#F4845F';
        ctx.lineWidth = 0.6;
        for (var a = 0; a < linkNodes.length; a++) {
            var pi = linkNodes[a];
            for (var b = a + 1; b < linkNodes.length; b++) {
                var pj = linkNodes[b];
                var dx = pi.x - pj.x, dy = pi.y - pj.y;
                var d = Math.sqrt(dx * dx + dy * dy);
                if (d < LINK_DIST) {
                    ctx.globalAlpha = (1 - d / LINK_DIST) * 0.7;
                    ctx.beginPath();
                    ctx.moveTo(cx + pi.x * radius, cy + pi.y * radius);
                    ctx.lineTo(cx + pj.x * radius, cy + pj.y * radius);
                    ctx.stroke();
                }
            }
        }

        for (var j = 0; j < particles.length; j++) {
            var p = particles[j];
            ctx.beginPath();
            ctx.arc(cx + p.x * radius, cy + p.y * radius, p.r, 0, Math.PI * 2);
            ctx.fillStyle = COLOR;
            ctx.globalAlpha = p.opacity;
            ctx.fill();
        }
        ctx.globalAlpha = 1;
        requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
}

function initMesh() {
    var el = document.getElementById('meshCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var wrap = el.parentElement;
    var W = wrap.offsetWidth;
    var H = 100;
    var dpr = window.devicePixelRatio || 1;

    el.width = W * dpr;
    el.height = H * dpr;
    el.style.width = W + 'px';
    el.style.height = H + 'px';

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    var COLS = 80;
    var ROWS = 18;
    var COLOR = '#E75437';
    var time = 0;

    function draw() {
        if (!document.body.contains(el)) return;
        time += 0.007;
        ctx.clearRect(0, 0, W, H);

        var cellW = W / (COLS - 1);
        var cellH = H / (ROWS - 1);
        var pts = [];

        for (var r = 0; r < ROWS; r++) {
            var row = [];
            for (var c = 0; c < COLS; c++) {
                var x = c * cellW;
                var y = r * cellH;
                var nx = c / (COLS - 1);
                var ny = r / (ROWS - 1);
                var w1 = Math.sin(nx * 12 + time * 1.1 + ny * 3) * 10;
                var w2 = Math.sin(nx * 7 - time * 0.9 + ny * 5) * 8;
                var w3 = Math.cos(ny * 8 + nx * 4 + time * 0.7) * 6;
                var w4 = Math.sin(nx * 18 + ny * 6 - time * 1.3) * 4;
                var w5 = Math.cos(nx * 9 - ny * 3.5 + time * 0.5) * 5;
                y += w1 + w2 + w3 + w4 + w5;
                row.push({ x: x, y: y });
            }
            pts.push(row);
        }

        for (var r = 0; r < ROWS; r++) {
            var ny = r / (ROWS - 1);
            var yFade = Math.pow(Math.sin(ny * Math.PI), 0.7);
            ctx.beginPath();
            ctx.moveTo(pts[r][0].x, pts[r][0].y);
            for (var c = 1; c < COLS; c++) {
                ctx.lineTo(pts[r][c].x, pts[r][c].y);
            }
            ctx.strokeStyle = COLOR;
            ctx.globalAlpha = (0.06 + yFade * 0.22);
            ctx.lineWidth = 0.5;
            ctx.stroke();
        }

        for (var c = 0; c < COLS; c++) {
            var nx = c / (COLS - 1);
            var xFade = Math.pow(Math.sin(nx * Math.PI), 1.2);
            ctx.beginPath();
            ctx.moveTo(pts[0][c].x, pts[0][c].y);
            for (var r = 1; r < ROWS; r++) {
                ctx.lineTo(pts[r][c].x, pts[r][c].y);
            }
            ctx.strokeStyle = COLOR;
            ctx.globalAlpha = (0.04 + xFade * 0.15);
            ctx.lineWidth = 0.35;
            ctx.stroke();
        }

        ctx.globalAlpha = 1;
        requestAnimationFrame(draw);
    }

    requestAnimationFrame(draw);
}

function initMiniLoop() {
    var el = document.getElementById('miniLoopCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var wrap = el.parentElement;
    var W = wrap.offsetWidth;
    var PAD = 40;
    var RX = (W / 2) - PAD;
    var RY = RX * 0.38;
    var H = RY * 0.75 + 40;

    var dpr = window.devicePixelRatio || 1;
    el.width = W * dpr;
    el.height = H * dpr;
    el.style.width = W + 'px';
    el.style.height = H + 'px';

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    var COLOR = '#E75437';
    var COUNT = 1000;
    var CX = W / 2, CY = H / 2;
    var TUBE = 10;
    var SPRING = 0.01;
    var DAMPING = 0.62;
    var BROWNIAN = 1.2;
    var TRAIL_STROKE = __dark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

    function lemX(t) {
        var s = Math.sin(t), c = Math.cos(t);
        return CX + (RX * c) / (1 + s * s);
    }
    function lemY(t) {
        var s = Math.sin(t), c = Math.cos(t);
        return CY + (RY * s * c) / (1 + s * s);
    }
    function normalAtT(t) {
        var dt = 0.001;
        var dx = lemX(t + dt) - lemX(t - dt);
        var dy = lemY(t + dt) - lemY(t - dt);
        var len = Math.sqrt(dx * dx + dy * dy);
        return { x: -dy / len, y: dx / len };
    }

    var TRAIL_PTS = 300;
    var outerTrail = [], innerTrail = [];
    for (var i = 0; i <= TRAIL_PTS; i++) {
        var t = (i / TRAIL_PTS) * Math.PI * 2;
        var n = normalAtT(t);
        var bx = lemX(t), by = lemY(t);
        outerTrail.push({ x: bx + n.x * TUBE, y: by + n.y * TUBE });
        innerTrail.push({ x: bx - n.x * TUBE, y: by - n.y * TUBE });
    }

    var particles = [];
    for (var i = 0; i < COUNT; i++) {
        var t = (i / COUNT) * Math.PI * 2;
        var speed = 0.005 + Math.random() * 0.008;
        var nOff = (Math.random() - 0.5) * TUBE * 0.8;
        particles.push({ t: t, speed: speed, r: 0.7 + Math.random() * 1.4, opacity: 0.2 + Math.random() * 0.65, nOff: nOff, nVel: 0 });
    }

    function drawPath(pts) {
        ctx.beginPath();
        ctx.moveTo(pts[0].x, pts[0].y);
        for (var i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
        ctx.closePath();
    }

    function tick() {
        if (!document.body.contains(el)) return;
        ctx.clearRect(0, 0, W, H);

        ctx.save();
        drawPath(outerTrail);
        ctx.strokeStyle = TRAIL_STROKE;
        ctx.lineWidth = 0.4;
        ctx.stroke();
        ctx.restore();

        ctx.save();
        drawPath(innerTrail);
        ctx.strokeStyle = TRAIL_STROKE;
        ctx.lineWidth = 0.4;
        ctx.stroke();
        ctx.restore();

        for (var j = 0; j < particles.length; j++) {
            var p = particles[j];
            p.t += p.speed;
            if (p.t > Math.PI * 2) p.t -= Math.PI * 2;
            p.nVel += (Math.random() - 0.5) * BROWNIAN;
            p.nVel += -p.nOff * SPRING;
            p.nVel *= DAMPING;
            p.nOff += p.nVel;
            var limit = TUBE * 0.85;
            if (p.nOff > limit) { p.nOff = limit; p.nVel *= -0.3; }
            if (p.nOff < -limit) { p.nOff = -limit; p.nVel *= -0.3; }
            var n = normalAtT(p.t);
            var px = lemX(p.t) + n.x * p.nOff;
            var py = lemY(p.t) + n.y * p.nOff;
            ctx.beginPath();
            ctx.arc(px, py, p.r, 0, Math.PI * 2);
            ctx.fillStyle = COLOR;
            ctx.globalAlpha = p.opacity;
            ctx.fill();
        }
        ctx.globalAlpha = 1;
        requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
}

function initMaturity() {
    var el = document.getElementById('maturityCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var wrap = el.parentElement;
    var W = wrap.offsetWidth;
    var H = 80;
    var dpr = window.devicePixelRatio || 1;

    el.width = W * dpr;
    el.height = H * dpr;
    el.style.width = W + 'px';
    el.style.height = H + 'px';

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    var COLOR = __dark ? '#4ADE80' : '#2D5F3E';
    var BASELINE = __dark ? '#333' : '#d4d4d4';
    var time = 0;
    var THIRD = W / 3;
    var PAD = 16;
    var NODE_R = 2.8;
    var zones = [];
    var CY = H / 2;
    var SPREAD_A = 14;
    var SPREAD_I = 18;
    var SPREAD_N = 22;

    (function() {
        var nodes = [];
        var count = 8;
        for (var i = 0; i < count; i++) {
            nodes.push({ x: PAD + Math.random() * (THIRD - PAD * 2), y: CY + (Math.random() - 0.5) * SPREAD_A * 2, vx: (Math.random() - 0.5) * 0.15, vy: (Math.random() - 0.5) * 0.08 });
        }
        zones.push({ nodes: nodes, edges: [[0, 2], [4, 6]], ox: 0, spread: SPREAD_A });
    })();

    (function() {
        var nodes = [];
        var count = 14;
        for (var i = 0; i < count; i++) {
            nodes.push({ x: PAD + Math.random() * (THIRD - PAD * 2), y: CY + (Math.random() - 0.5) * SPREAD_I * 2, vx: (Math.random() - 0.5) * 0.12, vy: (Math.random() - 0.5) * 0.08 });
        }
        var edges = [];
        for (var i = 0; i < count; i++) {
            var closest = -1; var dist = 9999;
            for (var j = 0; j < count; j++) {
                if (i === j) continue;
                var dx = nodes[i].x - nodes[j].x;
                var dy = nodes[i].y - nodes[j].y;
                var d = Math.sqrt(dx * dx + dy * dy);
                if (d < dist) { dist = d; closest = j; }
            }
            if (closest >= 0) edges.push([i, closest]);
            if (i % 3 === 0) {
                var sec = -1; var sd = 9999;
                for (var j = 0; j < count; j++) {
                    if (j === i || j === closest) continue;
                    var dx = nodes[i].x - nodes[j].x;
                    var dy = nodes[i].y - nodes[j].y;
                    var d = Math.sqrt(dx * dx + dy * dy);
                    if (d < sd) { sd = d; sec = j; }
                }
                if (sec >= 0) edges.push([i, sec]);
            }
        }
        zones.push({ nodes: nodes, edges: edges, ox: THIRD, spread: SPREAD_I });
    })();

    (function() {
        var nodes = [];
        var count = 24;
        for (var i = 0; i < count; i++) {
            nodes.push({ x: PAD + Math.random() * (THIRD - PAD * 2), y: CY + (Math.random() - 0.5) * SPREAD_N * 2, vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.1 });
        }
        var edges = [];
        var CONN_DIST = (THIRD - PAD * 2) * 0.45;
        for (var i = 0; i < count; i++) {
            for (var j = i + 1; j < count; j++) {
                var dx = nodes[i].x - nodes[j].x;
                var dy = nodes[i].y - nodes[j].y;
                if (Math.sqrt(dx * dx + dy * dy) < CONN_DIST) edges.push([i, j]);
            }
        }
        zones.push({ nodes: nodes, edges: edges, ox: THIRD * 2, spread: SPREAD_N });
    })();

    function draw() {
        if (!document.body.contains(el)) return;
        time += 0.01;
        ctx.clearRect(0, 0, W, H);

        ctx.beginPath();
        ctx.moveTo(0, H / 2);
        ctx.lineTo(W, H / 2);
        ctx.strokeStyle = BASELINE;
        ctx.globalAlpha = 1;
        ctx.lineWidth = 0.5;
        ctx.stroke();

        for (var z = 0; z < zones.length; z++) {
            var zone = zones[z];
            var ns = zone.nodes;
            var es = zone.edges;
            var ox = zone.ox;

            for (var i = 0; i < ns.length; i++) {
                var n = ns[i];
                n.x += n.vx;
                n.y += n.vy;
                n.vx += (Math.random() - 0.5) * 0.02;
                n.vy += (Math.random() - 0.5) * 0.02;
                n.vx *= 0.98;
                n.vy *= 0.98;
                if (n.x < PAD) { n.x = PAD; n.vx = Math.abs(n.vx); }
                if (n.x > THIRD - PAD) { n.x = THIRD - PAD; n.vx = -Math.abs(n.vx); }
                var sp = zone.spread;
                if (n.y < CY - sp) { n.y = CY - sp; n.vy = Math.abs(n.vy); }
                if (n.y > CY + sp) { n.y = CY + sp; n.vy = -Math.abs(n.vy); }
            }

            for (var e = 0; e < es.length; e++) {
                var a = ns[es[e][0]];
                var b = ns[es[e][1]];
                var dx = a.x - b.x;
                var dy = a.y - b.y;
                var d = Math.sqrt(dx * dx + dy * dy);
                var maxD = z === 2 ? (THIRD - PAD * 2) * 0.45 : 999;
                var alpha = z === 0 ? 0.08 : z === 1 ? 0.12 : Math.max(0, 0.15 * (1 - d / maxD));
                alpha *= 0.7 + 0.3 * Math.sin(time * 2 + e * 0.5);
                ctx.beginPath();
                ctx.moveTo(ox + a.x, a.y);
                ctx.lineTo(ox + b.x, b.y);
                ctx.strokeStyle = COLOR;
                ctx.globalAlpha = alpha;
                ctx.lineWidth = z === 2 ? 0.8 : 0.6;
                ctx.stroke();
            }

            for (var i = 0; i < ns.length; i++) {
                var n = ns[i];
                var pulse = 0.5 + 0.5 * Math.sin(time * 1.5 + i * 1.1);
                var isAgent = z === 2 && (i === 3 || i === 11 || i === 19);
                var nodeColor = isAgent ? '#78FF59' : COLOR;
                ctx.beginPath();
                ctx.arc(ox + n.x, n.y, NODE_R, 0, Math.PI * 2);
                ctx.fillStyle = nodeColor;
                ctx.globalAlpha = 0.55;
                ctx.fill();
                if (z === 2) {
                    ctx.beginPath();
                    ctx.arc(ox + n.x, n.y, NODE_R + 3, 0, Math.PI * 2);
                    ctx.fillStyle = nodeColor;
                    ctx.globalAlpha = isAgent ? 0.12 * pulse : 0.06 * pulse;
                    ctx.fill();
                }
            }
        }

        ctx.globalAlpha = 1;
        requestAnimationFrame(draw);
    }

    requestAnimationFrame(draw);
}

function initClosing() {
    var el = document.getElementById('closingCanvas');
    if (!el || el.dataset.init) return;
    el.dataset.init = '1';

    var SIZE = el.offsetWidth;
    if (SIZE < 10) return;

    var dpr = window.devicePixelRatio || 1;
    el.width = SIZE * dpr;
    el.height = SIZE * dpr;

    var ctx = el.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    var COLOR = '#E75437';
    var STROKE_COLOR = '#F4845F';
    var cx = SIZE / 2;
    var cy = SIZE / 2;
    var radius = SIZE / 2 - 4;

    // Same flow-field swirl constant as initHero — a quiet echo of the same system.
    var SWIRL = 1.7;
    function flowAngle(x, y, t) {
        return Math.sin(x * 2.3 + t * 0.30) * SWIRL
             + Math.cos(y * 2.1 - t * 0.27) * SWIRL
             + Math.sin((x + y) * 1.5 + t * 0.20);
    }

    var COUNT = 260;
    var particles = [];
    for (var i = 0; i < COUNT; i++) {
        // Resting target somewhere inside the disc...
        var tx, ty;
        do { tx = (Math.random() - 0.5) * 2; ty = (Math.random() - 0.5) * 2; }
        while (tx * tx + ty * ty > 1);
        // ...spawned scattered well outside it.
        var sa = Math.random() * Math.PI * 2;
        var sr = 1.6 + Math.random() * 1.4;
        particles.push({
            x: Math.cos(sa) * sr, y: Math.sin(sa) * sr,
            tx: tx, ty: ty,
            vx: 0, vy: 0,
            r: 0.8 + Math.random() * 1.8,
            baseOpacity: 0.2 + Math.random() * 0.55,
            pulsePhase: Math.random() * Math.PI * 2,
            pulseSpeed: 0.006 + Math.random() * 0.02,
            born: Math.random() * 0.7, // fraction of the assembly at which it appears
        });
    }

    var LINK_DIST = 0.32;
    var DURATION = 5000; // ms — the cluster assembles over ~5 seconds
    var startTime = null;
    var time = 0;

    function tick(now) {
        if (!document.body.contains(el)) return;
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / DURATION);
        time += 0.01;
        ctx.clearRect(0, 0, SIZE, SIZE);

        for (var j = 0; j < particles.length; j++) {
            var p = particles[j];
            if (progress < p.born) continue;
            // Pull toward the resting target, with a flow-field curl so paths
            // arc inward rather than travelling in straight lines.
            var fa = flowAngle(p.x, p.y, time);
            p.vx += (p.tx - p.x) * 0.012 + Math.cos(fa) * 0.0006;
            p.vy += (p.ty - p.y) * 0.012 + Math.sin(fa) * 0.0006;
            p.vx *= 0.9;
            p.vy *= 0.9;
            p.x += p.vx;
            p.y += p.vy;
            p.pulsePhase += p.pulseSpeed;
        }

        ctx.strokeStyle = STROKE_COLOR;
        ctx.lineWidth = 0.7;
        for (var a = 0; a < particles.length; a++) {
            var pi = particles[a];
            if (progress < pi.born) continue;
            for (var b = a + 1; b < particles.length; b++) {
                var pj = particles[b];
                if (progress < pj.born) continue;
                var dx = pi.x - pj.x, dy = pi.y - pj.y;
                var d = Math.sqrt(dx * dx + dy * dy);
                if (d < LINK_DIST) {
                    ctx.globalAlpha = (1 - d / LINK_DIST) * 0.4 * progress;
                    ctx.beginPath();
                    ctx.moveTo(cx + pi.x * radius, cy + pi.y * radius);
                    ctx.lineTo(cx + pj.x * radius, cy + pj.y * radius);
                    ctx.stroke();
                }
            }
        }

        for (var j = 0; j < particles.length; j++) {
            var p = particles[j];
            if (progress < p.born) continue;
            var appear = Math.min(1, (progress - p.born) / 0.12);
            ctx.beginPath();
            ctx.arc(cx + p.x * radius, cy + p.y * radius, p.r, 0, Math.PI * 2);
            ctx.fillStyle = COLOR;
            var pulse = 0.6 + 0.4 * Math.sin(p.pulsePhase);
            ctx.globalAlpha = p.baseOpacity * pulse * appear;
            ctx.fill();
        }
        ctx.globalAlpha = 1;
        requestAnimationFrame(tick);
    }

    // Assemble only once it scrolls into view — the story completing itself.
    var started = false;
    function start() {
        if (started) return;
        started = true;
        requestAnimationFrame(tick);
    }

    if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function(entries) {
            for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) { start(); obs.disconnect(); }
            }
        }, { threshold: 0.35 });
        obs.observe(el);
    } else {
        start();
    }
}

function initAll() {
    initHero();
    initNucleus();
    initMesh();
    initMiniLoop();
    initMaturity();
    initClosing();
}

initAll();
document.addEventListener('astro:page-load', function() {
    __dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    initAll();
});
</script>

