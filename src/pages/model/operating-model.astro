---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
---

<BaseLayout title="Operating Model">
    <div class="page-header">
        <h1>Operating Model</h1>
        <p class="page-header-desc">
            Evidence Work, Build Lifecycle, and SDLC are independent dimensions — not sequential phases.
            At any moment, work exists at a coordinate defined by confidence earned and investment depth.
        </p>
        <div class="page-meta">
            <span class="page-reading-time">4 min read</span>
        </div>
    </div>

    <section>
        <figure id="fig-2a">
            <div class="fig-label">Fig. 2A — Multi-Dimensional Operating Model</div>
            <div class="diagram">
                <svg viewBox="0 0 900 420" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;">
                    <style>
                        @keyframes sdlcSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
                        .sdlc-ring { animation: sdlcSpin 12s linear infinite; }
                    </style>
                    <defs>
                        <pattern id="dotGrid" patternUnits="userSpaceOnUse" width="10" height="10">
                            <circle cx="5" cy="5" r="1.2" fill="#c5c5c5"/>
                        </pattern>
                        <radialGradient id="cornerBR" cx="680" cy="310" r="420" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="white" stop-opacity="0.55"/>
                            <stop offset="30%" stop-color="white" stop-opacity="0.4"/>
                            <stop offset="55%" stop-color="white" stop-opacity="0.18"/>
                            <stop offset="72%" stop-color="white" stop-opacity="0.04"/>
                            <stop offset="82%" stop-color="white" stop-opacity="0"/>
                        </radialGradient>
                        <radialGradient id="cornerTL" cx="120" cy="60" r="380" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="white" stop-opacity="0.55"/>
                            <stop offset="30%" stop-color="white" stop-opacity="0.4"/>
                            <stop offset="55%" stop-color="white" stop-opacity="0.18"/>
                            <stop offset="72%" stop-color="white" stop-opacity="0.04"/>
                            <stop offset="82%" stop-color="white" stop-opacity="0"/>
                        </radialGradient>
                        <mask id="zoneMask">
                            <rect x="120" y="60" width="570" height="250" fill="url(#cornerBR)"/>
                            <rect x="120" y="60" width="570" height="250" fill="url(#cornerTL)"/>
                        </mask>
                    </defs>
                    <rect x="120" y="60" width="570" height="250" fill="url(#dotGrid)" mask="url(#zoneMask)"/>
                    <text x="585" y="290" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" fill="#dc2626" style="paint-order:stroke;stroke:white;stroke-width:4px;stroke-linejoin:round;">Invalid State — Investment Exceeds Confidence</text>
                    <text x="229" y="76" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-style="italic" fill="#a3a3a3" style="paint-order:stroke;stroke:white;stroke-width:4px;stroke-linejoin:round;">Threshold Exceeded — Promotion Required</text>
                    <circle cx="120" cy="310" r="4" fill="#4a4a4a"/>
                    <line x1="120" y1="310" x2="120" y2="60" stroke="#4a4a4a" stroke-width="1.5"/>
                    <polygon points="116,64 120,52 124,64" fill="#4a4a4a"/>
                    <line x1="114" y1="280" x2="126" y2="280" stroke="#d4d4d4" stroke-width="1"/>
                    <line x1="114" y1="185" x2="126" y2="185" stroke="#d4d4d4" stroke-width="1"/>
                    <line x1="114" y1="90" x2="126" y2="90" stroke="#d4d4d4" stroke-width="1"/>
                    <text x="108" y="284" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Low Confidence</text>
                    <text x="108" y="189" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Medium Confidence</text>
                    <text x="108" y="94" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">High Confidence</text>
                    <text x="120" y="32" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="10" font-weight="600" letter-spacing="0.05em" fill="#4a4a4a">EVIDENCE WORK</text>
                    <text x="120" y="44" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Confidence Earned</text>
                    <line x1="120" y1="310" x2="680" y2="310" stroke="#4a4a4a" stroke-width="1.5"/>
                    <polygon points="676,306 688,310 676,314" fill="#4a4a4a"/>
                    <line x1="260" y1="304" x2="260" y2="316" stroke="#d4d4d4" stroke-width="1"/>
                    <line x1="400" y1="304" x2="400" y2="316" stroke="#d4d4d4" stroke-width="1"/>
                    <line x1="540" y1="304" x2="540" y2="316" stroke="#d4d4d4" stroke-width="1"/>
                    <text x="260" y="332" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Concept</text>
                    <text x="400" y="332" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Validation</text>
                    <text x="540" y="332" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Commitment</text>
                    <text x="700" y="305" text-anchor="start" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="10" font-weight="600" letter-spacing="0.05em" fill="#4a4a4a">BUILD LIFECYCLE</text>
                    <text x="700" y="317" text-anchor="start" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Investment Intensity</text>
                    <g>
                        <circle cx="260" cy="370" r="16" fill="none" stroke="#737373" stroke-width="1" stroke-dasharray="3 2">
                            <animateTransform attributeName="transform" type="rotate" from="0 260 370" to="360 260 370" dur="12s" repeatCount="indefinite"/>
                        </circle>
                        <text x="260" y="373" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" fill="#525252">SDLC</text>
                        <text x="260" y="398" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Plan, Build,</text>
                        <text x="260" y="409" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Test, Release</text>
                    </g>
                    <g>
                        <circle cx="400" cy="370" r="16" fill="none" stroke="#737373" stroke-width="1" stroke-dasharray="3 2">
                            <animateTransform attributeName="transform" type="rotate" from="0 400 370" to="360 400 370" dur="12s" repeatCount="indefinite"/>
                        </circle>
                        <text x="400" y="373" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" fill="#525252">SDLC</text>
                        <text x="400" y="398" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Plan, Build,</text>
                        <text x="400" y="409" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Test, Release</text>
                    </g>
                    <g>
                        <circle cx="540" cy="370" r="16" fill="none" stroke="#737373" stroke-width="1" stroke-dasharray="3 2">
                            <animateTransform attributeName="transform" type="rotate" from="0 540 370" to="360 540 370" dur="12s" repeatCount="indefinite"/>
                        </circle>
                        <text x="540" y="373" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" fill="#525252">SDLC</text>
                        <text x="540" y="398" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Plan, Build,</text>
                        <text x="540" y="409" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#737373">Test, Release</text>
                    </g>
                    <circle cx="400" cy="185" r="6" fill="#E75437" opacity="0.9"/>
                    <line x1="400" y1="185" x2="400" y2="310" stroke="#E75437" stroke-width="0.75" stroke-dasharray="4 4" opacity="0.3"/>
                    <line x1="400" y1="185" x2="120" y2="185" stroke="#E75437" stroke-width="0.75" stroke-dasharray="4 4" opacity="0.3"/>
                    <text x="415" y="181" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" fill="#E75437">Current Work Coordinate</text>
                    <text x="415" y="193" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Confidence × Investment</text>
                    <text x="895" y="28" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" font-weight="500" letter-spacing="0.03em" fill="#a3a3a3">MULTI-DIMENSIONAL, NOT HIERARCHICAL</text>
                    <line x1="660" y1="34" x2="895" y2="34" stroke="#e5e5e5" stroke-width="0.5"/>
                    <text x="895" y="50" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Evidence Work →  <tspan font-weight="500" fill="#525252">governs confidence thresholds</tspan></text>
                    <text x="895" y="66" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">Build Lifecycle →  <tspan font-weight="500" fill="#525252">defines investment depth</tspan></text>
                    <text x="895" y="82" text-anchor="end" font-family="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif" font-size="9" fill="#a3a3a3">SDLC →  <tspan font-weight="500" fill="#525252">cycles execution within each stage</tspan></text>
                </svg>
            </div>
            <figcaption>
                These are dimensions, not layers. Evidence Work governs confidence. The Build Lifecycle
                defines investment depth. SDLC cycles within each stage — it is the execution engine,
                not a progression path. At any moment, work exists at a coordinate defined by confidence
                earned and investment depth.
            </figcaption>
        </figure>

        <figure id="fig-2b">
            <div class="fig-label">Fig. 2B — Capability Intensity Dial</div>

            <!-- Global: the meter rows are built in JS, so Astro's scoped-style hash never lands on them. -->
            <style is:global>
                .dial-wrap {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 48px;
                    align-items: start;
                    margin: 24px 0 0;
                }
                @media (max-width: 720px) { .dial-wrap { grid-template-columns: 1fr; gap: 32px; } }

                .dial-side { display: flex; flex-direction: column; align-items: center; }
                canvas#dial-canvas { display: block; width: 100%; max-width: 380px; aspect-ratio: 1; cursor: grab; }
                canvas#dial-canvas:active { cursor: grabbing; }
                .dial-signal-name {
                    margin-top: 12px;
                    font-family: 'Satoshi', sans-serif;
                    font-size: 18px; font-weight: 700;
                    color: #1a1a1a; text-align: center;
                    min-height: 28px;
                }
                .dial-signal-hint {
                    font-family: 'IBM Plex Mono', monospace;
                    font-size: 10px; letter-spacing: 0.08em;
                    text-transform: uppercase; color: #999;
                    margin-top: 2px; text-align: center;
                }

                .meters-side {
                    background: #1a1a1a;
                    border-radius: 12px;
                    padding: 24px 20px;
                    display: flex; flex-direction: column; gap: 16px;
                    box-shadow: inset 0 2px 8px rgba(0,0,0,0.4),
                                0 1px 0 rgba(255,255,255,0.05);
                }
                .vu-row { display: flex; align-items: center; gap: 12px; }
                .vu-label {
                    flex: 0 0 150px;
                    font-family: 'Satoshi', sans-serif;
                    font-size: 12px; font-weight: 500;
                    color: rgba(255,255,255,0.6);
                    text-align: right;
                }
                .vu-segments {
                    display: flex; gap: 3px; flex: 1;
                    align-items: center;
                }
                .vu-seg {
                    width: 0; flex: 1;
                    height: 22px;
                    border-radius: 2px;
                    background: #2a2a2a;
                    border: 1px solid #333;
                    transition: background 0.12s ease,
                                box-shadow 0.12s ease,
                                border-color 0.12s ease;
                }
                .vu-seg.lit-lo {
                    background: #4ade80;
                    border-color: #22c55e;
                    box-shadow: 0 0 6px rgba(74,222,128,0.5),
                                inset 0 1px 0 rgba(255,255,255,0.25);
                }
                .vu-seg.lit-mid {
                    background: #facc15;
                    border-color: #eab308;
                    box-shadow: 0 0 6px rgba(250,204,21,0.5),
                                inset 0 1px 0 rgba(255,255,255,0.25);
                }
                .vu-seg.lit-hi {
                    background: #ef4444;
                    border-color: #dc2626;
                    box-shadow: 0 0 8px rgba(239,68,68,0.6),
                                0 0 16px rgba(239,68,68,0.25),
                                inset 0 1px 0 rgba(255,255,255,0.2);
                }

                @media (max-width: 720px) {
                    .vu-label { flex: 0 0 100px; font-size: 11px; }
                    .vu-seg { height: 18px; }
                    .meters-side { padding: 16px 12px; }
                }
            </style>

            <div class="dial-wrap">
                <div class="dial-side">
                    <canvas id="dial-canvas"></canvas>
                    <div class="dial-signal-name" id="dial-signal-name"></div>
                    <div class="dial-signal-hint">Drag dial or click a stop</div>
                </div>
                <div class="meters-side" id="meters-side"></div>
            </div>

            <figcaption>
                Turn the dial to a type of work and watch how capability intensities shift.
                Every signal activates a different mix — nothing ever reaches zero, but the
                emphasis changes based on what the work demands.
            </figcaption>
        </figure>

        <script>
        (function(){
            /* ── Data ── */
            var SIGNALS = [
                { name: "Unknown Territory",  short: "Unknown" },
                { name: "Problem Discovery",  short: "Discover" },
                { name: "Solution Shaping",   short: "Shape" },
                { name: "Validation",         short: "Validate" },
                { name: "Production Build",   short: "Build" },
                { name: "Optimization",       short: "Optimize" },
            ];

            var CAPS = [
                "Defining Strategy",
                "Designing User Experience",
                "Experimenting with Spikes",
                "Engineering for Production",
                "Generating Active Evidence",
            ];

            var MATRIX = [
                [0.90, 0.30, 0.70, 0.10, 0.95],
                [0.80, 0.70, 0.60, 0.15, 0.85],
                [0.55, 0.90, 0.50, 0.25, 0.65],
                [0.35, 0.55, 0.80, 0.40, 0.90],
                [0.15, 0.25, 0.15, 0.90, 0.45],
                [0.25, 0.40, 0.25, 0.75, 0.35],
            ];

            var SEG_COUNT = 12;

            /* ── State ── */
            var currentAngle = -Math.PI / 2;
            var targetAngle  = currentAngle;
            var activeIdx    = 0;
            var dragging     = false;
            var displayVals  = MATRIX[0].slice();

            /* ── Canvas ── */
            var cvs = document.getElementById("dial-canvas");
            var ctx = cvs.getContext("2d");
            var namEl = document.getElementById("dial-signal-name");
            var metersEl = document.getElementById("meters-side");

            var dpr = window.devicePixelRatio || 1;
            var CX, CY, R, STOP_R, OUTER_R, KNURL_R;

            function resize() {
                var rect = cvs.getBoundingClientRect();
                var w = rect.width;
                cvs.width  = w * dpr;
                cvs.height = w * dpr;
                cvs.style.height = w + "px";
                CX = (w * dpr) / 2;
                CY = (w * dpr) / 2;
                R        = CX * 0.42;
                KNURL_R  = CX * 0.47;
                STOP_R   = CX * 0.65;
                OUTER_R  = CX * 0.82;
            }
            resize();
            window.addEventListener("resize", resize);

            /* ── Build VU meter rows ── */
            CAPS.forEach(function(cap, ci) {
                var row = document.createElement("div");
                row.className = "vu-row";
                var lbl = document.createElement("div");
                lbl.className = "vu-label";
                lbl.textContent = cap;
                row.appendChild(lbl);

                var segs = document.createElement("div");
                segs.className = "vu-segments";
                for (var s = 0; s < SEG_COUNT; s++) {
                    var seg = document.createElement("div");
                    seg.className = "vu-seg";
                    seg.id = "vs-" + ci + "-" + s;
                    segs.appendChild(seg);
                }
                row.appendChild(segs);
                metersEl.appendChild(row);
            });

            function updateMeters(values) {
                for (var ci = 0; ci < CAPS.length; ci++) {
                    var v = values[ci];
                    var litCount = Math.round(v * SEG_COUNT);
                    for (var s = 0; s < SEG_COUNT; s++) {
                        var seg = document.getElementById("vs-" + ci + "-" + s);
                        if (s < litCount) {
                            var frac = s / (SEG_COUNT - 1);
                            if (frac < 0.45)      seg.className = "vu-seg lit-lo";
                            else if (frac < 0.75)  seg.className = "vu-seg lit-mid";
                            else                   seg.className = "vu-seg lit-hi";
                        } else {
                            seg.className = "vu-seg";
                        }
                    }
                }
            }

            /* ── Angle helpers ── */
            var N = SIGNALS.length;
            var STEP = (Math.PI * 2) / N;

            function stopAngle(idx) { return -Math.PI / 2 + idx * STEP; }

            function normalizeAngle(a) {
                while (a < -Math.PI) a += Math.PI * 2;
                while (a >  Math.PI) a -= Math.PI * 2;
                return a;
            }

            function nearestStop(angle) {
                var best = 0, bestDist = Infinity;
                for (var i = 0; i < N; i++) {
                    var d = Math.abs(normalizeAngle(angle - stopAngle(i)));
                    if (d < bestDist) { bestDist = d; best = i; }
                }
                return best;
            }

            function lerpValues(angle) {
                var idx = nearestStop(angle);
                var sa  = stopAngle(idx);
                var diff = normalizeAngle(angle - sa);
                var absDiff = Math.abs(diff);
                if (absDiff < 0.01) return MATRIX[idx].slice();

                var neighborIdx = diff > 0 ? (idx + 1) % N : (idx - 1 + N) % N;
                var t = Math.min(absDiff / (STEP / 2), 1);
                t = t * t * (3 - 2 * t);
                var a = MATRIX[idx], b = MATRIX[neighborIdx];
                return a.map(function(v, i) { return v + (b[i] - v) * t; });
            }

            /* ── Knob Drawing ── */
            function draw() {
                ctx.clearRect(0, 0, cvs.width, cvs.height);
                var s = dpr;

                // tick marks between stops (subtle)
                ctx.strokeStyle = "#e0e0e0";
                ctx.lineWidth = 1 * s;
                for (var t = 0; t < N * 4; t++) {
                    var ta = -Math.PI / 2 + t * (Math.PI * 2 / (N * 4));
                    var isMajor = t % 4 === 0;
                    var innerT = isMajor ? STOP_R - 8 * s : STOP_R - 4 * s;
                    ctx.beginPath();
                    ctx.moveTo(CX + Math.cos(ta) * innerT, CY + Math.sin(ta) * innerT);
                    ctx.lineTo(CX + Math.cos(ta) * (STOP_R + 2 * s), CY + Math.sin(ta) * (STOP_R + 2 * s));
                    ctx.strokeStyle = isMajor ? "#ccc" : "#e8e8e8";
                    ctx.lineWidth = (isMajor ? 1.5 : 0.75) * s;
                    ctx.stroke();
                }

                // stop dots + labels
                for (var i = 0; i < N; i++) {
                    var a = stopAngle(i);
                    var sx = CX + Math.cos(a) * STOP_R;
                    var sy = CY + Math.sin(a) * STOP_R;
                    var isActive = i === activeIdx;

                    ctx.beginPath();
                    ctx.arc(sx, sy, (isActive ? 6 : 4) * s, 0, Math.PI * 2);
                    ctx.fillStyle = isActive ? "#E75437" : "#bbb";
                    ctx.fill();
                    if (isActive) {
                        ctx.beginPath();
                        ctx.arc(sx, sy, 10 * s, 0, Math.PI * 2);
                        ctx.strokeStyle = "rgba(231,84,55,0.25)";
                        ctx.lineWidth = 2 * s;
                        ctx.stroke();
                    }

                    var lx = CX + Math.cos(a) * OUTER_R;
                    var ly = CY + Math.sin(a) * OUTER_R;
                    ctx.font = (isActive ? "700 " : "400 ") + (12 * s) + "px Satoshi, sans-serif";
                    ctx.fillStyle = isActive ? "#1a1a1a" : "#888";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";

                    var offy = 0;
                    var sinA = Math.sin(a);
                    if (sinA < -0.6) offy = -14 * s;
                    else if (sinA > 0.6) offy = 14 * s;
                    ctx.fillText(SIGNALS[i].short, lx, ly + offy);
                }

                // ── Knob shadow ──
                ctx.save();
                ctx.beginPath();
                ctx.arc(CX, CY + 4 * s, KNURL_R + 2 * s, 0, Math.PI * 2);
                ctx.fillStyle = "rgba(0,0,0,0.10)";
                ctx.filter = "blur(" + (6 * s) + "px)";
                ctx.fill();
                ctx.restore();

                // ── Knob outer ring (knurled) ──
                var knurlGrad = ctx.createRadialGradient(CX, CY - R * 0.3, R * 0.1, CX, CY, KNURL_R);
                knurlGrad.addColorStop(0, "#d8d8d8");
                knurlGrad.addColorStop(0.7, "#b0b0b0");
                knurlGrad.addColorStop(1, "#909090");
                ctx.beginPath();
                ctx.arc(CX, CY, KNURL_R, 0, Math.PI * 2);
                ctx.fillStyle = knurlGrad;
                ctx.fill();

                // knurl ridges
                var ridgeCount = 48;
                for (var r = 0; r < ridgeCount; r++) {
                    var ra = (r / ridgeCount) * Math.PI * 2;
                    var rx1 = CX + Math.cos(ra) * (KNURL_R - 3 * s);
                    var ry1 = CY + Math.sin(ra) * (KNURL_R - 3 * s);
                    var rx2 = CX + Math.cos(ra) * KNURL_R;
                    var ry2 = CY + Math.sin(ra) * KNURL_R;
                    ctx.beginPath();
                    ctx.moveTo(rx1, ry1);
                    ctx.lineTo(rx2, ry2);
                    ctx.strokeStyle = r % 2 === 0 ? "rgba(255,255,255,0.35)" : "rgba(0,0,0,0.12)";
                    ctx.lineWidth = 1 * s;
                    ctx.stroke();
                }

                // ── Knob face ──
                var faceGrad = ctx.createRadialGradient(
                    CX - R * 0.15, CY - R * 0.2, R * 0.05,
                    CX, CY, R
                );
                faceGrad.addColorStop(0, "#f5f5f5");
                faceGrad.addColorStop(0.5, "#e8e8e8");
                faceGrad.addColorStop(1, "#d0d0d0");

                ctx.beginPath();
                ctx.arc(CX, CY, R, 0, Math.PI * 2);
                ctx.fillStyle = faceGrad;
                ctx.fill();

                // inner bevel ring
                ctx.beginPath();
                ctx.arc(CX, CY, R, 0, Math.PI * 2);
                ctx.strokeStyle = "rgba(255,255,255,0.5)";
                ctx.lineWidth = 1.5 * s;
                ctx.stroke();
                ctx.beginPath();
                ctx.arc(CX, CY, R - 2 * s, 0, Math.PI * 2);
                ctx.strokeStyle = "rgba(0,0,0,0.08)";
                ctx.lineWidth = 1 * s;
                ctx.stroke();

                // concentric rings on face for texture
                for (var cr = 0.25; cr < 0.9; cr += 0.15) {
                    ctx.beginPath();
                    ctx.arc(CX, CY, R * cr, 0, Math.PI * 2);
                    ctx.strokeStyle = "rgba(0,0,0,0.04)";
                    ctx.lineWidth = 0.5 * s;
                    ctx.stroke();
                }

                // ── Indicator notch ──
                var notchInner = R * 0.55;
                var notchOuter = R * 0.92;
                var nx1 = CX + Math.cos(currentAngle) * notchInner;
                var ny1 = CY + Math.sin(currentAngle) * notchInner;
                var nx2 = CX + Math.cos(currentAngle) * notchOuter;
                var ny2 = CY + Math.sin(currentAngle) * notchOuter;

                ctx.beginPath();
                ctx.moveTo(nx1, ny1);
                ctx.lineTo(nx2, ny2);
                ctx.strokeStyle = "#E75437";
                ctx.lineWidth = 3.5 * s;
                ctx.lineCap = "round";
                ctx.stroke();

                // indicator glow
                ctx.beginPath();
                ctx.moveTo(nx1, ny1);
                ctx.lineTo(nx2, ny2);
                ctx.strokeStyle = "rgba(231,84,55,0.25)";
                ctx.lineWidth = 8 * s;
                ctx.stroke();

                // ── Center cap ──
                var capGrad = ctx.createRadialGradient(
                    CX - 2 * s, CY - 3 * s, 1,
                    CX, CY, 10 * s
                );
                capGrad.addColorStop(0, "#666");
                capGrad.addColorStop(0.6, "#4a4a4a");
                capGrad.addColorStop(1, "#333");

                ctx.beginPath();
                ctx.arc(CX, CY, 10 * s, 0, Math.PI * 2);
                ctx.fillStyle = capGrad;
                ctx.fill();

                // cap highlight
                ctx.beginPath();
                ctx.arc(CX - 2 * s, CY - 2 * s, 4 * s, 0, Math.PI * 2);
                ctx.fillStyle = "rgba(255,255,255,0.25)";
                ctx.fill();
            }

            /* ── Animation loop ── */
            function tick() {
                if (!dragging && Math.abs(normalizeAngle(currentAngle - targetAngle)) > 0.003) {
                    var diff = normalizeAngle(targetAngle - currentAngle);
                    currentAngle += diff * 0.12;
                } else if (!dragging) {
                    currentAngle = targetAngle;
                }

                activeIdx = nearestStop(currentAngle);
                var targetVals = lerpValues(currentAngle);

                // smooth VU meter animation — lerp displayed values toward target
                for (var i = 0; i < displayVals.length; i++) {
                    displayVals[i] += (targetVals[i] - displayVals[i]) * 0.15;
                }
                updateMeters(displayVals);
                namEl.textContent = SIGNALS[activeIdx].name;

                draw();
                requestAnimationFrame(tick);
            }

            /* ── Interaction ── */
            function getAngleFromEvent(e) {
                var rect = cvs.getBoundingClientRect();
                var x = (e.clientX || (e.touches && e.touches[0].clientX) || 0) - rect.left - rect.width / 2;
                var y = (e.clientY || (e.touches && e.touches[0].clientY) || 0) - rect.top  - rect.height / 2;
                return Math.atan2(y, x);
            }

            cvs.addEventListener("mousedown", function(e) {
                dragging = true;
                currentAngle = getAngleFromEvent(e);
                targetAngle = currentAngle;
            });
            window.addEventListener("mousemove", function(e) {
                if (!dragging) return;
                currentAngle = getAngleFromEvent(e);
                targetAngle  = currentAngle;
            });
            window.addEventListener("mouseup", function() {
                if (!dragging) return;
                dragging = false;
                targetAngle = stopAngle(nearestStop(currentAngle));
            });

            cvs.addEventListener("touchstart", function(e) {
                e.preventDefault();
                dragging = true;
                currentAngle = getAngleFromEvent(e);
                targetAngle  = currentAngle;
            }, { passive: false });
            window.addEventListener("touchmove", function(e) {
                if (!dragging) return;
                currentAngle = getAngleFromEvent(e);
                targetAngle  = currentAngle;
            });
            window.addEventListener("touchend", function() {
                if (!dragging) return;
                dragging = false;
                targetAngle = stopAngle(nearestStop(currentAngle));
            });

            cvs.addEventListener("click", function(e) {
                targetAngle = stopAngle(nearestStop(getAngleFromEvent(e)));
            });

            /* ── Init ── */
            targetAngle  = stopAngle(0);
            currentAngle = targetAngle;
            updateMeters(MATRIX[0]);
            namEl.textContent = SIGNALS[0].name;
            tick();
        })();
        </script>
    </section>

