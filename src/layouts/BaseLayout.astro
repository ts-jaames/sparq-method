---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} — The Sparq Method</title>
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <ViewTransitions />
</head>
<body>
<div class="op">
    <header class="op-masthead">
        <a href="/" class="op-wordmark">The Sparq Method</a>
        <div class="op-edition">Internal operating system · v.0.1 · Edition 2026.1</div>
    </header>

    <main class="op-main">
        <div class="op-content" transition:animate="fade">
            <slot />
        </div>
    </main>

    <footer class="op-colophon">
        v1.0 · Edition 2026.1 · Last updated May 2026 · Internal use only
    </footer>
</div>
</body>
</html>
